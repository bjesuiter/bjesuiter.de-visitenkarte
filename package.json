{
  "name": "visitenkarte",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "bgproc start -n visitenkarte -f -w -- env PORTLESS_PORT=443 portless visitenkarte astro dev",
    "start": "bun dev",
    "build": "astro build",
    "prod": "bun run build",
    "preview": "astro preview",
    "test:visual": "bun run build && playwright test",
    "test:visual:update": "bun run build && playwright test --update-snapshots",
    "astro": "astro",
    "astroup": "bunx @astrojs/upgrade",
    "astro-add": "astro add",
    "prettier": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/tailwind": "6.0.2",
    "@chenglou/pretext": "0.0.8",
    "@iconify-json/bxl": "1.2.4",
    "@iconify-json/ion": "1.2.7",
    "@iconify-json/logos": "1.2.11",
    "@iconify-json/ph": "1.2.2",
    "@iconify-json/simple-icons": "1.2.86",
    "@tailwindcss/vite": "4.3.1",
    "astro": "6.4.7",
    "astro-font": "1.1.0",
    "astro-icon": "1.1.5",
    "sharp": "0.35.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "oxlint": "1.70.0",
    "prettier": "3.8.4",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwindcss-motion": "1.1.1"
  }
}
