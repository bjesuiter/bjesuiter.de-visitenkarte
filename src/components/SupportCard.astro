---
import SurfaceCard from "./ui/SurfaceCard.astro";

type SupportLocale = "de" | "en";

interface Props {
  locale?: SupportLocale;
}

const { locale = "de" } = Astro.props;

const content =
  locale === "de"
    ? {
        title: "Danke, dass du meine Arbeit unterstützen möchtest!",
        description:
          "Hier findest direkte Links, unter denen du mich supporten kannst oder die mir eine kleine Provision geben, wenn du sie nutzt. DANKE!",
        ariaLabel: "Support-Links",
        links: [
          {
            href: "https://ko-fi.com/codemonument",
            label: "Ko-Fi für bjesuiter/codemonument",
          },
          {
            href: "https://railway.com?referralCode=bjesuiter",
            label: "Hosting via Railway.com",
          },
        ],
      }
    : {
        title: "Thanks for supporting my work.",
        description:
          "Here are direct links that support me, either directly or through referral commissions.",
        ariaLabel: "Support links",
        links: [
          {
            href: "https://ko-fi.com/codemonument",
            label: "Ko-fi for bjesuiter/codemonument",
          },
          {
            href: "https://railway.com?referralCode=bjesuiter",
            label: "Hosting via Railway.com",
          },
        ],
      };

const cardClass = "max-w-[760px] p-[clamp(1.2rem,3vw,2rem)] text-emerald-50";
const linkClass =
  "grid grid-cols-[1fr_auto] items-center gap-[0.6rem] rounded-xl border border-emerald-300/30 bg-[rgba(2,20,15,0.42)] px-[0.8rem] py-[0.65rem] font-tech text-emerald-50 transition duration-200 hover:border-emerald-300 focus-visible:border-emerald-300 focus-visible:outline-none";
const openLabelClass =
  "text-[0.65rem] uppercase tracking-[0.08em] text-emerald-200";
---

<SurfaceCard class={cardClass}>
  <p
    class="font-tech mb-2 text-sm tracking-[0.09em] text-emerald-300 uppercase"
  >
    Support
  </p>
  <h1
    class="font-display mb-3 text-[clamp(1.6rem,4vw,2.4rem)] leading-[1.1] text-balance text-emerald-50"
  >
    {content.title}
  </h1>
  <p class="font-tech max-w-[60ch] leading-[1.55] text-[#c9f7e3]">
    {content.description}
  </p>

  <ul
    class="mt-4 grid list-none gap-[0.65rem] p-0"
    aria-label={content.ariaLabel}
  >
    {
      content.links.map((link) => (
        <li>
          <a
            href={link.href}
            target="_blank"
            rel="noreferrer"
            class={linkClass}
          >
            <span>{link.label}</span>
            <span aria-hidden="true" class={openLabelClass}>
              open
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</SurfaceCard>
