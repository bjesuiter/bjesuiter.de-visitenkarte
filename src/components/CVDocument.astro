---
import { Image } from "astro:assets";
import profilePic from "../assets/2023-03-17_square_near_profilepic.jpeg";
import { getLocalizedCvContent, type CvLocale } from "../data/cv";
import CVIntro from "./CVIntro.astro";

interface Props {
  locale?: CvLocale;
}

const { locale = "de" } = Astro.props;
const content = getLocalizedCvContent(locale);
const toolbarAriaLabel = locale === "de" ? "Lebenslauf-Aktionen" : "CV actions";
const profileImageAlt =
  locale === "de"
    ? "Porträt von Benjamin Jesuiter"
    : "Portrait of Benjamin Jesuiter";
const languageSwitchHref = locale === "de" ? "/en/cv/" : "/de/lebenslauf/";
---

<main class="cv-page">
  {
    /*
    TODO(bjesuiter): Re-enable this CV toolbar once there is a real print/download mode.
    Keep the existing markup for the future print-mode implementation instead of deleting it.
  <div class="cv-toolbar print-hidden" aria-label={toolbarAriaLabel}>
    <div class="cv-toolbar-shell">
      <div class="cv-toolbar-copy gap-4">
        <p class="cv-toolbar-kicker">{content.badge}</p>
        <p class="cv-toolbar-note">{content.printHint}</p>
      </div>

      <div class="cv-toolbar-actions">
        <a
          href={languageSwitchHref}
          class="cv-action cv-action-secondary"
        >
          {content.navigation.languageSwitchLabel}
        </a>
        <button
          type="button"
          class="cv-action cv-action-print"
          onclick="window.__cvPrintMode('print')"
        >
          {content.navigation.printLabel}
        </button>
        <button
          type="button"
          class="cv-action cv-action-download"
          onclick="window.__cvPrintMode('download')"
        >
          {content.navigation.downloadLabel}
        </button>
      </div>
    </div>
  </div>
  */
  }

  <article class="cv-sheet">
    <!-- Hero section with the main heading, intro copy, and profile image. -->
    <header class="cv-hero gap-4">
      <div class="cv-hero-copy gap-4">
        <p class="cv-badge">{content.badge}</p>
        <h1>{content.heading}</h1>
        <CVIntro locale={locale} />
      </div>

      <div class="cv-hero-media">
        <Image
          src={profilePic}
          alt={profileImageAlt}
          loading="eager"
          class="cv-hero-image"
        />
      </div>
    </header>

    <!-- Top overview grid with personal facts on the left and contact details on the right. -->
    <section class="cv-grid cv-top-grid cv-section-shell gap-4">
      <!-- Quick facts section for personal and professional summary data. -->
      <!-- English heading: Profile -->
      <section class="cv-panel cv-surface cv-surface-strong">
        <h2>{content.factsTitle}</h2>
        <dl class="cv-facts gap-4">
          {
            content.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd class="text-balance">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <!-- Contact links and industry focus section. -->
      <!-- English heading: Links -->
      <section class="cv-panel cv-panel-mirrored cv-surface">
        <h2>{content.contactTitle}</h2>
        <ul class="cv-link-list">
          {
            content.contactLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noreferrer"
                  class="cv-link-card cv-surface-inset"
                >
                  <span>{link.label}</span>
                  <span>{link.href.replace(/^https?:\/\//, "")}</span>
                </a>
              </li>
            ))
          }
        </ul>

        <!-- English heading: Industries -->
        <h2 class="cv-subheading">{content.industriesTitle}</h2>
        <ul class="cv-chip-list">
          {content.industries.map((industry) => <li>{industry}</li>)}
        </ul>
      </section>
    </section>

    <!-- Skills dossier section grouped by category and specialization. -->
    <!-- English heading: IT Skills -->
    <section class="cv-section-shell cv-section cv-skills-section">
      <div class="cv-section-heading">
        <h2 class="pl-2">{content.skillsTitle}</h2>
      </div>

      <!-- Skill cards break capabilities into clear categories for quick scanning. -->
      <div class="cv-skills-grid gap-4">
        {
          content.skillCategories.map((category) => (
            <section class="cv-skill-card">
              <div class="cv-card-heading">
                <h3>{category.title}</h3>
              </div>
              <ul class="gap-4">
                {category.items.map((item) =>
                  typeof item === "string" ? (
                    <li>{item}</li>
                  ) : "items" in item ? (
                    <li class="cv-skill-group">
                      <span class="cv-skill-group-label">
                        <span class="cv-skill-group-dot" aria-hidden="true" />
                        <span>{item.label}</span>
                      </span>
                      <ul class="cv-skill-sublist">
                        {item.items.map((subItem) => (
                          <li class="cv-skill-sublist-item">{subItem}</li>
                        ))}
                      </ul>
                    </li>
                  ) : (
                    <li class="cv-skill-chip-row">
                      <span>{item.text}</span>
                      <span class="cv-chip">{item.chip}</span>
                    </li>
                  ),
                )}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <!-- Project portfolio section with detailed case studies and technology stacks. -->
    <!-- English heading: Project History -->
    <section class="cv-section-shell cv-section cv-project-history-section">
      <div class="cv-section-heading">
        <div>
          <h2 class="pl-1">{content.projectsTitle}</h2>
          <p class="pl-1">{content.projectsIntro}</p>
        </div>
      </div>

      <!-- Project cards highlight selected work with context, outcomes, and stack details. -->
      <div class="cv-projects">
        {
          content.projects.map((project, index) => (
            <article class="cv-project-card cv-surface cv-surface-project">
              <header class="cv-project-header gap-4">
                <div class="cv-project-title-block gap-4">
                  <div class="cv-project-eyebrow">
                    <span class="cv-card-index">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <p class="cv-project-period">{project.period}</p>
                  </div>
                  <p class="cv-project-sector">{project.sector}</p>
                  <h3>{project.title}</h3>
                </div>

                <dl class="cv-project-meta gap-4">
                  {project.duration && (
                    <div class="cv-surface-inset">
                      {/* English label: Project Duration */}
                      <dt>{content.durationLabel}</dt>
                      <dd>{project.duration}</dd>
                    </div>
                  )}
                  {project.teamSize && (
                    <div class="cv-surface-inset">
                      {/* English label: Team Size */}
                      <dt>{content.teamSizeLabel}</dt>
                      <dd>{project.teamSize}</dd>
                    </div>
                  )}
                  <div class="cv-surface-inset cv-project-meta-roles">
                    {/* English label: Roles */}
                    <dt>{content.rolesLabel}</dt>
                    <dd>{project.roles.join(" · ")}</dd>
                  </div>
                </dl>
              </header>

              <div class="cv-project-divider" aria-hidden="true" />

              <div class="cv-project-body gap-4">
                {/* Narrative summary describing the challenge, work, and impact of the project. */}
                <div class="cv-project-copy gap-4">
                  <section class="cv-project-summary">
                    {project.summary.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </section>

                  <section class="cv-project-spacer" aria-hidden="true" />

                  {/* Key highlights sit directly below the project description without card styling. */}
                  {/* English heading: Responsibilities & Outcomes */}
                  <section class="cv-project-highlights">
                    <h4>{content.highlightsTitle}</h4>
                    <ul class="cv-project-highlights-list gap-4">
                      {project.highlights.map((highlight) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                  </section>
                </div>

                {/* Technical Context - Technology stack section listing the tools and platforms used. */}
                {/* English heading: Technical Context */}
                <section class="cv-detail-card cv-surface-inset cv-brace-frame-vertical">
                  <h4>{content.stackTitle}</h4>
                  <dl class="cv-stack-list gap-4">
                    {project.stack.map((item) => (
                      <div>
                        <dt>{item.label}</dt>
                        <dd>{item.value}</dd>
                      </div>
                    ))}
                  </dl>
                </section>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </article>
</main>

<!-- Inline script that switches styling modes before printing or downloading the CV. -->
<script is:inline>
  (() => {
    const syncPrintActiveState = () => {
      const root = document.documentElement;
      const isPreview = root.hasAttribute("data-print-preview");

      if (isPreview) {
        root.dataset.cvPrintActive = "true";
        document.body?.setAttribute("data-cv-print-active", "true");
        return;
      }

      delete root.dataset.cvPrintActive;
      document.body?.removeAttribute("data-cv-print-active");
    };

    const setMode = (mode) => {
      document.documentElement.setAttribute("cata-cv-output", mode);
      document.body?.setAttribute("cata-cv-output", mode);
      document.documentElement.dataset.cvPrintActive = "true";
      document.body?.setAttribute("data-cv-print-active", "true");
    };

    const clearMode = () => {
      document.documentElement.removeAttribute("cata-cv-output");
      document.body?.removeAttribute("cata-cv-output");
      syncPrintActiveState();
    };

    window.__cvPrintMode = (mode) => {
      setMode(mode);
      window.print();
    };

    window.addEventListener("beforeprint", () => {
      document.documentElement.dataset.cvPrintActive = "true";
      document.body?.setAttribute("data-cv-print-active", "true");
    });
    window.addEventListener("afterprint", clearMode);
    syncPrintActiveState();
  })();
</script>

<!-- Global styles for the on-screen cv layout and print/download output. -->
<style is:global>
  .cv-page {
    --cv-content-width: 1140px;
    --cv-page-padding: 0.8rem;
    --cv-dock-overlap: 8.25rem;
    --cv-divider: rgba(167, 243, 208, 0.12);
    --cv-divider-strong: rgba(167, 243, 208, 0.2);
    --cv-panel-radius: 14px;
    --cv-sheet-padding: 1.1rem;
    --cv-panel-border: rgba(167, 243, 208, 0.14);
    --cv-dossier-frame-depth: calc(var(--cv-panel-radius) + 12px);
    --cv-dossier-frame-fade: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.2) 8%,
      #000 16%,
      #000 84%,
      rgba(0, 0, 0, 0.2) 92%,
      transparent 100%
    );
    --cv-panel-surface: rgba(4, 23, 18, 0.84);
    --cv-panel-surface-strong: rgba(6, 28, 21, 0.9);
    min-height: 100vh;
    margin-top: calc(var(--cv-dock-overlap) * -1);
    padding: calc(var(--cv-page-padding) + var(--cv-dock-overlap))
      var(--cv-page-padding) var(--cv-page-padding);
    background: #02110d;
    color: #ecfdf5;
  }

  .cv-toolbar,
  .cv-sheet {
    width: min(var(--cv-content-width), 100%);
    margin-inline: auto;
  }

  .cv-toolbar {
    margin-bottom: 1rem;
  }

  .cv-toolbar-shell {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem 1rem;
    padding: 0.9rem;
    border-radius: 20px;
    border: 1px solid rgba(167, 243, 208, 0.18);
    background: rgba(3, 21, 16, 0.8);
    box-shadow:
      0 16px 34px rgba(1, 10, 7, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(16px);
  }

  .cv-toolbar-copy,
  .cv-hero,
  .cv-hero-copy,
  .cv-grid,
  .cv-facts,
  .cv-skills-grid,
  .cv-projects,
  .cv-project-header,
  .cv-project-title-block,
  .cv-project-meta,
  .cv-project-body,
  .cv-project-copy,
  .cv-stack-list,
  .cv-project-highlights-list,
  .cv-skill-card ul,
  .cv-detail-card ul {
    display: grid;
  }

  .cv-toolbar-copy {
    gap: 0.22rem;
    max-width: 54rem;
  }

  .cv-toolbar-kicker,
  .cv-badge,
  .cv-card-index,
  .cv-facts dt,
  .cv-project-meta dt,
  .cv-stack-list dt,
  .cv-project-period,
  .cv-link-list a span:first-child {
    font-family: "Chakra Petch", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
  }

  .cv-toolbar-kicker {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: #86efac;
  }

  .cv-toolbar-note {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #c7f3df;
  }

  .cv-toolbar-actions {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    justify-content: stretch;
    gap: 0.75rem;
  }

  .cv-action {
    appearance: none;
    display: inline-flex;
    flex: 1 1 100%;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.7rem 1.1rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-family: "Chakra Petch", sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 170ms ease,
      border-color 170ms ease,
      filter 170ms ease,
      background-color 170ms ease,
      color 170ms ease,
      box-shadow 170ms ease;
  }

  .cv-action:hover {
    transform: translateY(-1px);
  }

  .cv-action-secondary {
    color: #d8fbed;
    border-color: rgba(167, 243, 208, 0.18);
    background: rgba(7, 34, 26, 0.56);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .cv-action-secondary:hover {
    border-color: rgba(110, 231, 183, 0.5);
    background: rgba(8, 39, 29, 0.82);
  }

  .cv-action-download {
    color: #032015;
    border-color: rgba(255, 255, 255, 0.24);
    background: #9ef0c7;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.2);
  }

  .cv-action-download:hover {
    filter: brightness(1.04);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.28);
  }

  .cv-action-print {
    color: #d8fbed;
    border-color: rgba(167, 243, 208, 0.28);
    background: rgba(3, 24, 18, 0.72);
    box-shadow:
      0 12px 26px rgba(1, 10, 7, 0.24),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(18px);
  }

  .cv-action-print:hover {
    border-color: #6ee7b7;
    background: rgba(5, 30, 22, 0.92);
  }

  .cv-sheet {
    padding: 1.1rem;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid rgba(167, 243, 208, 0.18);
    background: rgba(4, 21, 17, 0.92);
    box-shadow: 0 24px 52px rgba(1, 10, 7, 0.42);
  }

  .cv-hero {
    gap: 1.15rem;
    margin: calc(var(--cv-sheet-padding) * -1)
      calc(var(--cv-sheet-padding) * -1) 0;
    padding: var(--cv-sheet-padding) var(--cv-sheet-padding) 1.6rem;
    background:
      linear-gradient(90deg, rgba(220, 252, 231, 0.015) 1px, transparent 1px) 0
        0 / 34px 100%,
      rgba(4, 21, 17, 0.92);
  }

  .cv-hero-copy {
    gap: 0.95rem;
    align-content: start;
  }

  .cv-badge {
    margin: 0;
    font-size: 0.84rem;
    letter-spacing: 0.14em;
    color: #6ee7b7;
  }

  .cv-hero h1,
  .cv-section h2,
  .cv-panel h2,
  .cv-project-card h3,
  .cv-project-highlights h4,
  .cv-detail-card h4,
  .cv-skill-card h3 {
    margin: 0;
    font-family: "Fraunces", serif;
    text-wrap: balance;
    color: #ecfdf5;
  }

  .cv-hero h1 {
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
  }

  .cv-intro {
    max-width: 72ch;
    margin: 0;
    font-size: clamp(1rem, 1.5vw, 1.08rem);
    line-height: 1.75;
    color: #c7f3df;
  }

  .cv-intro p {
    margin: 0;
  }

  .cv-intro p + p {
    margin-top: 0.45rem;
  }

  .cv-intro strong {
    color: #ecfdf5;
  }

  .cv-hero-media {
    position: relative;
    min-height: 18rem;
    overflow: hidden;
    border-radius: 28px;
    border: 1px solid rgba(167, 243, 208, 0.18);
    background: rgba(5, 23, 19, 0.82);
    box-shadow: 0 24px 48px rgba(1, 10, 7, 0.28);
  }

  .cv-hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(3, 16, 12, 0.02) 0%,
      rgba(4, 28, 19, 0.18) 70%,
      rgba(3, 16, 12, 0.5) 100%
    );
  }

  .cv-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: saturate(0.88) contrast(1.04) brightness(1);
  }

  .cv-top-grid,
  .cv-section,
  .cv-skills-grid,
  .cv-projects {
    margin-top: 1rem;
  }

  .cv-surface {
    overflow: hidden;
    border: 1px solid var(--cv-panel-border);
    border-radius: var(--cv-panel-radius);
    background: var(--cv-panel-surface);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 14px 28px rgba(1, 10, 7, 0.16);
    backdrop-filter: blur(8px);
  }

  .cv-surface-soft {
    overflow: hidden;
    border: 1px solid rgba(167, 243, 208, 0.12);
    border-radius: 18px;
    background: rgba(4, 20, 16, 0.5);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 12px 24px rgba(1, 10, 7, 0.14);
    backdrop-filter: blur(8px);
  }

  .cv-surface-inset {
    border: 1px solid rgba(167, 243, 208, 0.12);
    border-radius: 16px;
    background: rgba(4, 20, 16, 0.46);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }

  .cv-surface-project {
    --cv-timeline-strip-color: rgba(110, 231, 183, 0.42);
    --cv-timeline-strip-width: 2px;
    --cv-timeline-strip-wrap: 1.5rem;
    position: relative;
    border: 0;
    background: rgba(4, 21, 17, 0.78);
  }

  .cv-surface-project::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--cv-timeline-strip-wrap) + var(--cv-timeline-strip-width));
    border-top: var(--cv-timeline-strip-width) solid
      var(--cv-timeline-strip-color);
    border-bottom: var(--cv-timeline-strip-width) solid
      var(--cv-timeline-strip-color);
    border-left: var(--cv-timeline-strip-width) solid
      var(--cv-timeline-strip-color);
    border-top-left-radius: var(--cv-panel-radius);
    border-bottom-left-radius: var(--cv-panel-radius);
    pointer-events: none;
    -webkit-mask-image: linear-gradient(
      90deg,
      #000 0,
      #000 calc(100% - 0.92rem),
      rgba(0, 0, 0, 0.72) calc(100% - 0.56rem),
      rgba(0, 0, 0, 0.28) calc(100% - 0.18rem),
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      #000 0,
      #000 calc(100% - 0.92rem),
      rgba(0, 0, 0, 0.72) calc(100% - 0.56rem),
      rgba(0, 0, 0, 0.28) calc(100% - 0.18rem),
      transparent 100%
    );
  }

  .cv-panel {
    padding: 1.1rem;
  }

  .cv-section-shell {
    padding-inline: 0;
  }

  .cv-panel-mirrored {
    padding: 1.1rem 1.16rem 1.1rem 1.1rem;
  }

  .cv-section {
    padding-top: 0;
    border-top: 0;
  }

  .cv-section-frame {
    position: relative;
    overflow: hidden;
    border: 0;
  }

  .cv-skills-section,
  .cv-project-history-section {
    padding-top: 1rem;
  }

  .cv-skills-section {
    --cv-section-clamp-depth: 0.78rem;
    --cv-section-clamp-inset-left: 1.1rem;
    --cv-section-clamp-inset-right: 1.1rem;
  }

  .cv-section-frame::before,
  .cv-section-frame::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: var(--cv-dossier-frame-depth);
    pointer-events: none;
    -webkit-mask-image: var(--cv-dossier-frame-fade);
    mask-image: var(--cv-dossier-frame-fade);
  }

  .cv-section-frame::before {
    top: 0;
    border-top: 1px dashed var(--cv-divider-strong);
    border-left: 1px dashed var(--cv-divider-strong);
    border-right: 1px dashed var(--cv-divider-strong);
    border-top-left-radius: var(--cv-panel-radius);
    border-top-right-radius: var(--cv-panel-radius);
  }

  .cv-section-frame::after {
    bottom: 0;
    border-bottom: 1px dashed var(--cv-divider-strong);
    border-left: 1px dashed var(--cv-divider-strong);
    border-right: 1px dashed var(--cv-divider-strong);
    border-bottom-left-radius: var(--cv-panel-radius);
    border-bottom-right-radius: var(--cv-panel-radius);
  }

  .cv-skills-section.cv-section-frame::before,
  .cv-skills-section.cv-section-frame::after {
    left: var(--cv-section-clamp-inset-left);
    right: var(--cv-section-clamp-inset-right);
    height: var(--cv-section-clamp-depth);
    -webkit-mask-image: none;
    mask-image: none;
  }

  .cv-skills-section.cv-section-frame::before {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
  }

  .cv-skills-section.cv-section-frame::after {
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
  }

  .cv-section-heading {
    margin-bottom: 1rem;
  }

  .cv-panel h2,
  .cv-section h2 {
    font-size: clamp(1.35rem, 2vw, 1.9rem);
  }

  .cv-section-heading p {
    margin: 0.45rem 0 0;
    line-height: 1.6;
    color: #bdeed8;
  }

  .cv-subheading {
    margin-top: 1.35rem !important;
  }

  .cv-facts {
    gap: 0.9rem;
    margin-top: 1.05rem;
  }

  .cv-facts > div,
  .cv-stack-list > div,
  .cv-project-meta > div {
    display: grid;
    gap: 0.2rem;
  }

  .cv-facts > div + div,
  .cv-stack-list > div + div {
    padding-top: 0.7rem;
    border-top: 1px dashed var(--cv-divider);
  }

  .cv-facts dt,
