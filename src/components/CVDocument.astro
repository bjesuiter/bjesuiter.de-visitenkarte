---
import { Image } from "astro:assets";
import profilePic from "../assets/2023-03-17_square_near_profilepic.jpeg";
import { getLocalizedResumeContent, type ResumeLocale } from "../data/cv";
import CVIntro from "./CVIntro.astro";

interface Props {
  locale?: ResumeLocale;
}

const { locale = "de" } = Astro.props;
const content = getLocalizedResumeContent(locale);
const toolbarAriaLabel = locale === "de" ? "Lebenslauf-Aktionen" : "CV actions";
const profileImageAlt =
  locale === "de"
    ? "Porträt von Benjamin Jesuiter"
    : "Portrait of Benjamin Jesuiter";
---

<main class="resume-page">
  <div class="resume-toolbar print-hidden" aria-label={toolbarAriaLabel}>
    <div class="resume-toolbar-actions">
      <button
        type="button"
        class="resume-action resume-action-download"
        onclick="window.__resumePrintMode('download')"
      >
        {content.navigation.downloadLabel}
      </button>
      <button
        type="button"
        class="resume-action resume-action-print"
        onclick="window.__resumePrintMode('print')"
      >
        {content.navigation.printLabel}
      </button>
    </div>
  </div>

  <article class="resume-sheet">
    <header class="resume-hero">
      <div class="resume-hero-copy">
        <p class="resume-badge">{content.badge}</p>
        <h1>{content.heading}</h1>
        <CVIntro locale={locale} />
      </div>

      <div class="resume-hero-media">
        <Image
          src={profilePic}
          alt={profileImageAlt}
          loading="eager"
          class="resume-hero-image"
        />
      </div>
    </header>

    <section class="resume-grid resume-top-grid">
      <section class="resume-panel resume-panel-emphasis">
        <h2>{content.factsTitle}</h2>
        <dl class="resume-facts">
          {
            content.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd class="text-balance">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="resume-panel resume-panel-emphasis-mirrored">
        <h2>{content.contactTitle}</h2>
        <ul class="resume-link-list">
          {
            content.contactLinks.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noreferrer">
                  <span>{link.label}</span>
                  <span>{link.href.replace(/^https?:\/\//, "")}</span>
                </a>
              </li>
            ))
          }
        </ul>

        <h2 class="resume-subheading">{content.industriesTitle}</h2>
        <ul class="resume-chip-list">
          {content.industries.map((industry) => <li>{industry}</li>)}
        </ul>
      </section>
    </section>

    <section class="resume-panel resume-section">
      <div class="resume-section-heading">
        <h2>{content.skillsTitle}</h2>
      </div>

      <div class="resume-skills-grid">
        {
          content.skillCategories.map((category) => (
            <section class="resume-skill-card">
              <h3>{category.title}</h3>
              <ul>
                {category.items.map((item) =>
                  typeof item === "string" ? (
                    <li>{item}</li>
                  ) : "items" in item ? (
                    <li class="resume-skill-group">
                      <span class="resume-skill-group-label">{item.label}</span>
                      <ul class="resume-skill-sublist">
                        {item.items.map((subItem) => (
                          <li class="resume-skill-sublist-item">{subItem}</li>
                        ))}
                      </ul>
                    </li>
                  ) : (
                    <li class="resume-skill-chip-row">
                      <span>{item.text}</span>
                      <span class="resume-chip">{item.chip}</span>
                    </li>
                  ),
                )}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <section class="resume-section">
      <div class="resume-section-heading">
        <div>
          <h2>{content.projectsTitle}</h2>
          <p>{content.projectsIntro}</p>
        </div>
      </div>

      <div class="resume-projects">
        {
          content.projects.map((project) => (
            <article class="resume-project-card">
              <header class="resume-project-header">
                <div>
                  <p class="resume-project-period">{project.period}</p>
                  <p class="resume-project-sector">{project.sector}</p>
                  <h3>{project.title}</h3>
                </div>

                <dl class="resume-project-meta">
                  {project.duration && (
                    <div>
                      <dt>{content.durationLabel}</dt>
                      <dd>{project.duration}</dd>
                    </div>
                  )}
                  {project.teamSize && (
                    <div>
                      <dt>{content.teamSizeLabel}</dt>
                      <dd>{project.teamSize}</dd>
                    </div>
                  )}
                  <div>
                    <dt>{content.rolesLabel}</dt>
                    <dd>{project.roles.join(" · ")}</dd>
                  </div>
                </dl>
              </header>

              <div class="resume-project-body">
                <div class="resume-project-copy">
                  {project.summary.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>

                <section class="resume-detail-card">
                  <h4>{content.highlightsTitle}</h4>
                  <ul>
                    {project.highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                </section>

                <section class="resume-detail-card">
                  <h4>{content.stackTitle}</h4>
                  <dl class="resume-stack-list">
                    {project.stack.map((item) => (
                      <div>
                        <dt>{item.label}</dt>
                        <dd>{item.value}</dd>
                      </div>
                    ))}
                  </dl>
                </section>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </article>
</main>

<script is:inline>
  (() => {
    const setMode = (mode) => {
      document.documentElement.dataset.resumeOutput = mode;
      document.body?.setAttribute("data-resume-output", mode);
    };

    const clearMode = () => {
      delete document.documentElement.dataset.resumeOutput;
      document.body?.removeAttribute("data-resume-output");
    };

    window.__resumePrintMode = (mode) => {
      setMode(mode);
      window.print();
    };

    window.addEventListener("afterprint", clearMode);
  })();
</script>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,700&display=swap");

  .resume-page {
    --resume-page-padding: clamp(1rem, 2.4vw, 2.1rem);
    --resume-dock-overlap: 5.8rem;
    --resume-divider: rgba(167, 243, 208, 0.14);
    --resume-divider-strong: rgba(167, 243, 208, 0.22);
    --resume-panel-radius: 14px;
    --resume-panel-border: rgba(167, 243, 208, 0.18);
    --resume-panel-border-strong: rgba(167, 243, 208, 0.28);
    --resume-panel-surface: linear-gradient(
      160deg,
      rgba(4, 28, 21, 0.9),
      rgba(4, 23, 18, 0.82)
    );
    --resume-panel-wash: radial-gradient(
      120% 70% at 50% 0%,
      rgba(110, 231, 183, 0.13),
      transparent 58%
    );
    min-height: 100vh;
    margin-top: calc(var(--resume-dock-overlap) * -1);
    padding: calc(var(--resume-page-padding) + var(--resume-dock-overlap))
      var(--resume-page-padding) var(--resume-page-padding);
    background:
      linear-gradient(0deg, rgba(4, 18, 15, 0.93), rgba(4, 18, 15, 0.93)),
      radial-gradient(
        circle at 82% 12%,
        rgba(110, 231, 183, 0.34),
        transparent 30%
      ),
      radial-gradient(
        circle at 12% 88%,
        rgba(34, 197, 94, 0.28),
        transparent 30%
      ),
      #02110d;
    color: #ecfdf5;
  }

  .resume-toolbar {
    width: min(1140px, 100%);
    margin: 0 auto 1rem;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.9rem;
  }

  .resume-toolbar-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .resume-action {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    border-radius: 999px;
    padding: 0.7rem 1.1rem;
    font-family: "Chakra Petch", sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      transform 170ms ease,
      border-color 170ms ease,
      filter 170ms ease,
      background-color 170ms ease,
      color 170ms ease;
  }

  .resume-action:hover {
    transform: translateY(-1px);
  }

  .resume-action-download {
    color: #032015;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: linear-gradient(90deg, #a7f3d0, #6ee7b7);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.24);
  }

  .resume-action-download:hover {
    filter: brightness(1.04);
  }

  .resume-action-print {
    color: #d8fbed;
    border: 1px solid rgba(167, 243, 208, 0.28);
    background: rgba(3, 24, 18, 0.72);
    box-shadow:
      0 16px 34px rgba(1, 10, 7, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(18px);
  }

  .resume-action-print:hover {
    border-color: #6ee7b7;
    background: rgba(5, 30, 22, 0.92);
  }

  .resume-sheet {
    width: min(1140px, 100%);
    margin: 0 auto;
    padding: clamp(1.1rem, 2vw, 1.8rem);
    border-radius: 22px;
    overflow: hidden;
    border: 1px dashed rgba(167, 243, 208, 0.24);
    background:
      linear-gradient(90deg, rgba(220, 252, 231, 0.02) 1px, transparent 1px) 0
        0 / 34px 100%,
      linear-gradient(0deg, rgba(220, 252, 231, 0.015) 1px, transparent 1px) 0
        0 / 100% 34px,
      linear-gradient(135deg, rgba(7, 30, 24, 0.95), rgba(5, 24, 19, 0.84));
    box-shadow: 0 24px 52px rgba(1, 10, 7, 0.55);
  }

  .resume-hero {
    display: grid;
    gap: 1rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px dashed var(--resume-divider-strong);
  }

  .resume-badge {
    margin: 0 0 0.75rem;
    font-family: "Chakra Petch", sans-serif;
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6ee7b7;
  }

  .resume-hero h1,
  .resume-section h2,
  .resume-panel h2,
  .resume-project-card h3,
  .resume-detail-card h4,
  .resume-skill-card h3 {
    font-family: "Fraunces", serif;
    text-wrap: balance;
  }

  .resume-hero h1 {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
    color: #ecfdf5;
  }

  .resume-intro {
    max-width: 72ch;
    margin: 1rem 0 0;
    font-size: clamp(1rem, 1.5vw, 1.08rem);
    line-height: 1.75;
    color: #c7f3df;
  }

  .resume-intro p {
    margin: 0;
  }

  .resume-intro p + p {
    margin-top: 0.45rem;
  }

  .resume-intro strong {
    color: #ecfdf5;
  }

  .resume-hero-media {
    position: relative;
    min-height: 19rem;
    border-radius: 22px;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 24% 22%,
        rgba(110, 231, 183, 0.18),
        transparent 28%
      ),
      linear-gradient(135deg, rgba(5, 26, 20, 0.82), rgba(3, 18, 14, 0.48));
    box-shadow: 0 18px 40px rgba(1, 10, 7, 0.28);
  }

  .resume-hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 22% 18%,
        rgba(110, 231, 183, 0.16),
        transparent 30%
      ),
      linear-gradient(
        180deg,
        rgba(3, 16, 12, 0.04) 0%,
        rgba(6, 32, 22, 0.14) 42%,
        rgba(4, 28, 19, 0.5) 72%,
        rgba(3, 16, 12, 0.84) 100%
      );
    pointer-events: none;
  }

  .resume-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: saturate(0.84) contrast(1.03) brightness(0.98);
  }

  .resume-hero-note {
    width: 100%;
    max-width: 32rem;
    justify-self: start;
    border-radius: 18px;
    background:
      radial-gradient(
        circle at 12% 20%,
        rgba(110, 231, 183, 0.14),
        transparent 32%
      ),
      linear-gradient(120deg, rgba(5, 26, 20, 0.92), rgba(5, 30, 22, 0.72));
    padding: 0.95rem 1rem;
    color: #d7fbec;
  }

  .resume-hero-note p {
    margin: 0;
    line-height: 1.6;
  }

  .resume-grid {
    display: grid;
    gap: 1rem;
  }

  .resume-top-grid {
    margin-top: 1rem;
  }

  .resume-top-grid > * + * {
    padding-top: 0;
    border-top: 0;
  }

  .resume-panel,
  .resume-project-card,
  .resume-skill-card {
    border-radius: var(--resume-panel-radius);
    border: 1px dashed var(--resume-panel-border);
    background: var(--resume-panel-wash), var(--resume-panel-surface);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 14px 28px rgba(1, 10, 7, 0.2);
    backdrop-filter: blur(10px);
  }

  .resume-panel {
    padding: 1.1rem;
  }

  .resume-panel-emphasis,
  .resume-panel-emphasis-mirrored {
    border-color: var(--resume-panel-border-strong);
    background:
      radial-gradient(
        120% 70% at 50% 0%,
        rgba(110, 231, 183, 0.18),
        transparent 58%
      ),
      linear-gradient(160deg, rgba(5, 31, 24, 0.95), rgba(4, 26, 20, 0.86));
  }

  .resume-panel h2,
  .resume-section h2 {
    margin: 0;
    font-size: clamp(1.35rem, 2vw, 1.9rem);
    color: #ecfdf5;
  }

  .resume-subheading {
    margin-top: 1.35rem !important;
  }

  .resume-facts {
    display: grid;
    gap: 0.9rem;
    margin-top: 1.05rem;
  }

  .resume-facts div,
  .resume-stack-list div {
    display: grid;
    gap: 0.2rem;
  }

  .resume-facts div + div,
  .resume-stack-list div + div {
    border-top: 1px dashed var(--resume-divider);
    padding-top: 0.7rem;
  }

  .resume-facts dt,
  .resume-project-meta dt,
  .resume-stack-list dt {
    font-family: "Chakra Petch", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6ee7b7;
  }

  .resume-facts dd,
  .resume-project-meta dd,
  .resume-stack-list dd {
    margin: 0;
    line-height: 1.6;
    color: #d7fbec;
  }

  .resume-link-list,
  .resume-chip-list,
  .resume-skill-card ul,
  .resume-detail-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .resume-link-list {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.05rem;
  }

  .resume-link-list li + li {
    border-top: 1px dashed var(--resume-divider);
    padding-top: 0.7rem;
  }

  .resume-link-list a {
    display: grid;
    gap: 0.22rem;
    padding: 0;
    border-radius: 16px;
    border: 0;
    background: transparent;
    transition:
      color 170ms ease,
      transform 170ms ease;
  }

  .resume-link-list a:hover {
    transform: translateX(2px);
  }

  .resume-link-list a span:first-child {
    font-family: "Chakra Petch", sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6ee7b7;
  }

  .resume-link-list a span:last-child {
    color: #d7fbec;
    line-height: 1.6;
    word-break: break-word;
  }

  .resume-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  /*
    Keep these pills visually explicit.
    A lighter/softer treatment made the industries read like plain wrapped text,
    while this stronger background + border makes the intended tag grouping clear.
    Reuse this approach if similar pill lists start looking too subtle again.
  */
  .resume-chip-list li {
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    background: rgba(6, 33, 25, 0.9);
    color: #ecfdf5;
    border: 1px solid rgba(110, 231, 183, 0.3);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 0 0 1px rgba(3, 24, 18, 0.32);
    line-height: 1.4;
  }

  .resume-section {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--resume-divider-strong);
  }

  .resume-panel.resume-section {
    padding-bottom: 1rem;
  }

  .resume-panel.resume-section + .resume-section {
    padding-top: 1rem;
    border-top: 1px dashed var(--resume-divider-strong);
  }

  .resume-section-heading {
    margin-bottom: 1rem;
  }

  .resume-section-heading p {
    margin: 0.45rem 0 0;
    line-height: 1.6;
    color: #bdeed8;
  }

  .resume-skills-grid {
    display: grid;
    gap: 0.9rem 1rem;
  }

  .resume-skill-card {
    padding: 1rem;
  }

  .resume-skill-card h3 {
    margin: 0 0 0.7rem;
    font-size: 1.08rem;
    color: #ecfdf5;
  }

  .resume-skill-card ul {
    display: grid;
    gap: 0.42rem;
  }

  .resume-skill-group-label {
    font-weight: 500;
    color: #ddfced;
  }

  .resume-skill-sublist {
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.2rem;
    column-gap: 0.35rem;
    margin-top: 0.32rem;
    margin-left: 0;
    padding-left: 0;
  }

  .resume-skill-sublist .resume-skill-sublist-item {
    list-style: none;
    position: static;
    padding-left: 0;
    line-height: 1.35;
    font-size: 0.9em;
  }

  .resume-skill-sublist .resume-skill-sublist-item::before {
    content: "·";
    position: static;
    display: inline-block;
    width: auto;
    height: auto;
    margin-right: 0.35rem;
    border-radius: 0;
    background: none;
    color: rgba(110, 231, 183, 0.85);
  }

  .resume-skill-chip-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .resume-chip {
    display: inline-block;
    border: 1px solid rgba(110, 231, 183, 0.24);
    background: rgba(16, 185, 129, 0.06);
    color: rgba(187, 247, 208, 0.78);
    border-radius: 999px;
    padding: 0.08rem 0.45rem;
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .resume-skill-card li,
  .resume-detail-card li,
  .resume-project-copy p {
    line-height: 1.7;
    color: #c7f3df;
  }

  .resume-skill-card li,
  .resume-detail-card li {
    position: relative;
    padding-left: 1rem;
  }

  .resume-skill-card li::before,
  .resume-detail-card li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72rem;
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 999px;
    background: #6ee7b7;
  }

  .resume-skill-card li.resume-skill-group::before {
    top: 0.78rem;
    width: 0.26rem;
    height: 0.26rem;
  }

  .resume-projects {
    display: grid;
    gap: 1.1rem;
  }

  .resume-project-card {
    position: relative;
    overflow: hidden;
    border-color: var(--resume-panel-border-strong);
  }

  .resume-project-card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: linear-gradient(
      180deg,
      rgba(110, 231, 183, 0.94),
      rgba(110, 231, 183, 0.12)
    );
    pointer-events: none;
  }

  .resume-project-header {
    display: grid;
    gap: 1rem;
    padding: 1.1rem 1.1rem 1rem 1.25rem;
    border-bottom: 1px dashed var(--resume-divider-strong);
    background:
      radial-gradient(
        110% 62% at 40% 0%,
        rgba(110, 231, 183, 0.14),
        transparent 60%
      ),
      linear-gradient(160deg, rgba(5, 30, 23, 0.95), rgba(5, 26, 20, 0.88));
  }

  .resume-project-period,
  .resume-project-sector {
    margin: 0;
    color: #6ee7b7;
    font-weight: 700;
  }

  .resume-project-period {
    font-family: "Chakra Petch", sans-serif;
    font-size: 0.84rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .resume-project-sector {
    margin-top: 0.45rem;
    font-size: 0.94rem;
  }

  .resume-project-card h3 {
    margin: 0.5rem 0 0;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    line-height: 1.15;
    color: #ecfdf5;
  }

  .resume-project-meta {
    display: grid;
    gap: 0.7rem;
    margin-top: 0.15rem;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--resume-divider);
  }

  .resume-project-body {
    display: grid;
    gap: 1rem;
    padding: 1.1rem 1.1rem 1.1rem 1.25rem;
  }

  .resume-project-body > * + * {
    padding-top: 1rem;
    border-top: 1px dashed var(--resume-divider);
  }

  .resume-project-copy {
    display: grid;
    gap: 0.8rem;
  }

  .resume-project-copy p {
    margin: 0;
  }

  .resume-detail-card {
    padding: 0;
