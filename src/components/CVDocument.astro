---
import { Image } from "astro:assets";
import profilePic from "../assets/2023-03-17_square_near_profilepic.jpeg";
import { getLocalizedResumeContent, type ResumeLocale } from "../data/cv";
import CVIntro from "./CVIntro.astro";

interface Props {
  locale?: ResumeLocale;
}

const { locale = "de" } = Astro.props;
const content = getLocalizedResumeContent(locale);
const toolbarAriaLabel = locale === "de" ? "Lebenslauf-Aktionen" : "CV actions";
const profileImageAlt =
  locale === "de"
    ? "Porträt von Benjamin Jesuiter"
    : "Portrait of Benjamin Jesuiter";
const languageSwitchHref = locale === "de" ? "/en/cv/" : "/de/lebenslauf/";
---

<main class="resume-page">
  <!-- Toolbar with language switch and print/download actions for the CV view. -->
  <div class="resume-toolbar print-hidden" aria-label={toolbarAriaLabel}>
    <div class="resume-toolbar-shell">
      <div class="resume-toolbar-copy gap-4">
        <p class="resume-toolbar-kicker">{content.badge}</p>
        <p class="resume-toolbar-note">{content.printHint}</p>
      </div>

      <div class="resume-toolbar-actions">
        <a
          href={languageSwitchHref}
          class="resume-action resume-action-secondary"
        >
          {content.navigation.languageSwitchLabel}
        </a>
        <button
          type="button"
          class="resume-action resume-action-print"
          onclick="window.__resumePrintMode('print')"
        >
          {content.navigation.printLabel}
        </button>
        <button
          type="button"
          class="resume-action resume-action-download"
          onclick="window.__resumePrintMode('download')"
        >
          {content.navigation.downloadLabel}
        </button>
      </div>
    </div>
  </div>

  <article class="resume-sheet">
    <!-- Hero section with the main heading, intro copy, and profile image. -->
    <header class="resume-hero resume-panel resume-section-frame gap-4">
      <div class="resume-hero-copy gap-4">
        <p class="resume-badge">{content.badge}</p>
        <h1>{content.heading}</h1>
        <CVIntro locale={locale} />
      </div>

      <div class="resume-hero-media">
        <Image
          src={profilePic}
          alt={profileImageAlt}
          loading="eager"
          class="resume-hero-image"
        />
      </div>
    </header>

    <!-- Top overview grid with personal facts on the left and contact details on the right. -->
    <section
      class="resume-grid resume-top-grid resume-panel resume-section-frame gap-4"
    >
      <!-- Quick facts section for personal and professional summary data. -->
      <section class="resume-panel resume-surface resume-surface-strong">
        <h2>{content.factsTitle}</h2>
        <dl class="resume-facts gap-4">
          {
            content.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd class="text-balance">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <!-- Contact links and industry focus section. -->
      <section
        class="resume-panel resume-panel-mirrored resume-surface resume-surface-strong"
      >
        <h2>{content.contactTitle}</h2>
        <ul class="resume-link-list">
          {
            content.contactLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noreferrer"
                  class="resume-link-card resume-surface-inset"
                >
                  <span>{link.label}</span>
                  <span>{link.href.replace(/^https?:\/\//, "")}</span>
                </a>
              </li>
            ))
          }
        </ul>

        <h2 class="resume-subheading">{content.industriesTitle}</h2>
        <ul class="resume-chip-list">
          {content.industries.map((industry) => <li>{industry}</li>)}
        </ul>
      </section>
    </section>

    <!-- Skills dossier section grouped by category and specialization. -->
    <section class="resume-panel resume-section resume-section-frame">
      <div class="resume-section-heading">
        <h2>{content.skillsTitle}</h2>
      </div>

      <!-- Skill cards break capabilities into clear categories for quick scanning. -->
      <div class="resume-skills-grid gap-4">
        {
          content.skillCategories.map((category) => (
            <section class="resume-skill-card">
              <div class="resume-card-heading">
                <h3>{category.title}</h3>
              </div>
              <ul class="gap-4">
                {category.items.map((item) =>
                  typeof item === "string" ? (
                    <li>{item}</li>
                  ) : "items" in item ? (
                    <li class="resume-skill-group">
                      <span class="resume-skill-group-label">{item.label}</span>
                      <ul class="resume-skill-sublist">
                        {item.items.map((subItem) => (
                          <li class="resume-skill-sublist-item">{subItem}</li>
                        ))}
                      </ul>
                    </li>
                  ) : (
                    <li class="resume-skill-chip-row">
                      <span>{item.text}</span>
                      <span class="resume-chip">{item.chip}</span>
                    </li>
                  ),
                )}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <!-- Project portfolio section with detailed case studies and technology stacks. -->
    <section class="resume-section resume-panel resume-section-frame">
      <div class="resume-section-heading">
        <div>
          <h2>{content.projectsTitle}</h2>
          <p>{content.projectsIntro}</p>
        </div>
      </div>

      <!-- Project cards highlight selected work with context, outcomes, and stack details. -->
      <div class="resume-projects gap-4">
        {
          content.projects.map((project, index) => (
            <article class="resume-project-card resume-surface resume-surface-project">
              <header class="resume-project-header resume-surface-strong gap-4">
                <div class="resume-project-title-block gap-4">
                  <div class="resume-project-eyebrow">
                    <span class="resume-card-index">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <p class="resume-project-period">{project.period}</p>
                  </div>
                  <p class="resume-project-sector">{project.sector}</p>
                  <h3>{project.title}</h3>
                </div>

                <dl class="resume-project-meta gap-4">
                  {project.duration && (
                    <div class="resume-surface-inset">
                      <dt>{content.durationLabel}</dt>
                      <dd>{project.duration}</dd>
                    </div>
                  )}
                  {project.teamSize && (
                    <div class="resume-surface-inset">
                      <dt>{content.teamSizeLabel}</dt>
                      <dd>{project.teamSize}</dd>
                    </div>
                  )}
                  <div class="resume-surface-inset">
                    <dt>{content.rolesLabel}</dt>
                    <dd>{project.roles.join(" · ")}</dd>
                  </div>
                </dl>
              </header>

              <div class="resume-project-body gap-4">
                {/* Narrative summary describing the challenge, work, and impact of the project. */}
                <div class="resume-project-copy gap-4">
                  {project.summary.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>

                {/* Key highlights section calling out notable results and contributions. */}
                <section class="resume-detail-card resume-surface-inset">
                  <h4>{content.highlightsTitle}</h4>
                  <ul class="gap-4">
                    {project.highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                </section>

                {/* Technology stack section listing the tools and platforms used. */}
                <section class="resume-detail-card resume-surface-inset">
                  <h4>{content.stackTitle}</h4>
                  <dl class="resume-stack-list gap-4">
                    {project.stack.map((item) => (
                      <div>
                        <dt>{item.label}</dt>
                        <dd>{item.value}</dd>
                      </div>
                    ))}
                  </dl>
                </section>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </article>
</main>

<!-- Inline script that switches styling modes before printing or downloading the CV. -->
<script is:inline>
  (() => {
    const setMode = (mode) => {
      document.documentElement.dataset.resumeOutput = mode;
      document.body?.setAttribute("data-resume-output", mode);
    };

    const clearMode = () => {
      delete document.documentElement.dataset.resumeOutput;
      document.body?.removeAttribute("data-resume-output");
    };

    window.__resumePrintMode = (mode) => {
      setMode(mode);
      window.print();
    };

    window.addEventListener("afterprint", clearMode);
  })();
</script>

<!-- Global styles for the on-screen resume layout and print/download output. -->
<style is:global>
  .resume-page {
    --resume-content-width: 1140px;
    --resume-page-padding: 0.8rem;
    --resume-dock-overlap: 8.25rem;
    --resume-divider: rgba(167, 243, 208, 0.12);
    --resume-divider-strong: rgba(167, 243, 208, 0.2);
    --resume-panel-radius: 14px;
    --resume-panel-border: rgba(167, 243, 208, 0.14);
    --resume-dossier-frame-depth: calc(var(--resume-panel-radius) + 12px);
    --resume-dossier-frame-fade: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.2) 8%,
      #000 16%,
      #000 84%,
      rgba(0, 0, 0, 0.2) 92%,
      transparent 100%
    );
    --resume-panel-surface: rgba(4, 23, 18, 0.84);
    --resume-panel-surface-strong: rgba(6, 28, 21, 0.9);
    min-height: 100vh;
    margin-top: calc(var(--resume-dock-overlap) * -1);
    padding: calc(var(--resume-page-padding) + var(--resume-dock-overlap))
      var(--resume-page-padding) var(--resume-page-padding);
    background: #02110d;
    color: #ecfdf5;
  }

  .resume-toolbar,
  .resume-sheet {
    width: min(var(--resume-content-width), 100%);
    margin-inline: auto;
  }

  .resume-toolbar {
    margin-bottom: 1rem;
  }

  .resume-toolbar-shell {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem 1rem;
    padding: 0.9rem;
    border-radius: 20px;
    border: 1px solid rgba(167, 243, 208, 0.18);
    background: rgba(3, 21, 16, 0.8);
    box-shadow:
      0 16px 34px rgba(1, 10, 7, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(16px);
  }

  .resume-toolbar-copy,
  .resume-hero,
  .resume-hero-copy,
  .resume-grid,
  .resume-facts,
  .resume-skills-grid,
  .resume-projects,
  .resume-project-header,
  .resume-project-title-block,
  .resume-project-meta,
  .resume-project-body,
  .resume-project-copy,
  .resume-stack-list,
  .resume-skill-card ul,
  .resume-detail-card ul {
    display: grid;
  }

  .resume-toolbar-copy {
    gap: 0.22rem;
    max-width: 54rem;
  }

  .resume-toolbar-kicker,
  .resume-badge,
  .resume-card-index,
  .resume-facts dt,
  .resume-project-meta dt,
  .resume-stack-list dt,
  .resume-project-period,
  .resume-link-list a span:first-child {
    font-family: "Chakra Petch", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
  }

  .resume-toolbar-kicker {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: #86efac;
  }

  .resume-toolbar-note {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: #c7f3df;
  }

  .resume-toolbar-actions {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    justify-content: stretch;
    gap: 0.75rem;
  }

  .resume-action {
    appearance: none;
    display: inline-flex;
    flex: 1 1 100%;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.7rem 1.1rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-family: "Chakra Petch", sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 170ms ease,
      border-color 170ms ease,
      filter 170ms ease,
      background-color 170ms ease,
      color 170ms ease,
      box-shadow 170ms ease;
  }

  .resume-action:hover {
    transform: translateY(-1px);
  }

  .resume-action-secondary {
    color: #d8fbed;
    border-color: rgba(167, 243, 208, 0.18);
    background: rgba(7, 34, 26, 0.56);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .resume-action-secondary:hover {
    border-color: rgba(110, 231, 183, 0.5);
    background: rgba(8, 39, 29, 0.82);
  }

  .resume-action-download {
    color: #032015;
    border-color: rgba(255, 255, 255, 0.24);
    background: #9ef0c7;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.2);
  }

  .resume-action-download:hover {
    filter: brightness(1.04);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.28);
  }

  .resume-action-print {
    color: #d8fbed;
    border-color: rgba(167, 243, 208, 0.28);
    background: rgba(3, 24, 18, 0.72);
    box-shadow:
      0 12px 26px rgba(1, 10, 7, 0.24),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(18px);
  }

  .resume-action-print:hover {
    border-color: #6ee7b7;
    background: rgba(5, 30, 22, 0.92);
  }

  .resume-sheet {
    padding: 1.1rem;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid rgba(167, 243, 208, 0.18);
    background:
      linear-gradient(90deg, rgba(220, 252, 231, 0.015) 1px, transparent 1px) 0
        0 / 34px 100%,
      rgba(4, 21, 17, 0.92);
    box-shadow: 0 24px 52px rgba(1, 10, 7, 0.42);
  }

  .resume-hero {
    gap: 1.15rem;
  }

  .resume-hero.resume-section-frame {
    padding-bottom: 1.6rem;
  }

  .resume-hero-copy {
    gap: 0.95rem;
    align-content: start;
  }

  .resume-badge {
    margin: 0;
    font-size: 0.84rem;
    letter-spacing: 0.14em;
    color: #6ee7b7;
  }

  .resume-hero h1,
  .resume-section h2,
  .resume-panel h2,
  .resume-project-card h3,
  .resume-detail-card h4,
  .resume-skill-card h3 {
    margin: 0;
    font-family: "Fraunces", serif;
    text-wrap: balance;
    color: #ecfdf5;
  }

  .resume-hero h1 {
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
  }

  .resume-intro {
    max-width: 72ch;
    margin: 0;
    font-size: clamp(1rem, 1.5vw, 1.08rem);
    line-height: 1.75;
    color: #c7f3df;
  }

  .resume-intro p {
    margin: 0;
  }

  .resume-intro p + p {
    margin-top: 0.45rem;
  }

  .resume-intro strong {
    color: #ecfdf5;
  }

  .resume-hero-media {
    position: relative;
    min-height: 18rem;
    overflow: hidden;
    border-radius: 28px;
    border: 1px solid rgba(167, 243, 208, 0.18);
    background: rgba(5, 23, 19, 0.82);
    box-shadow: 0 24px 48px rgba(1, 10, 7, 0.28);
  }

  .resume-hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(3, 16, 12, 0.02) 0%,
      rgba(4, 28, 19, 0.18) 70%,
      rgba(3, 16, 12, 0.5) 100%
    );
  }

  .resume-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: saturate(0.88) contrast(1.04) brightness(1);
  }

  .resume-top-grid,
  .resume-section,
  .resume-skills-grid,
  .resume-projects {
    margin-top: 1rem;
  }

  .resume-surface {
    overflow: hidden;
    border: 1px solid var(--resume-panel-border);
    border-radius: var(--resume-panel-radius);
    background: var(--resume-panel-surface);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 14px 28px rgba(1, 10, 7, 0.16);
    backdrop-filter: blur(8px);
  }

  .resume-surface-soft {
    overflow: hidden;
    border: 1px solid rgba(167, 243, 208, 0.12);
    border-radius: 18px;
    background: rgba(4, 20, 16, 0.5);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 12px 24px rgba(1, 10, 7, 0.14);
    backdrop-filter: blur(8px);
  }

  .resume-surface-inset {
    border: 1px solid rgba(167, 243, 208, 0.12);
    border-radius: 16px;
    background: rgba(4, 20, 16, 0.46);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }

  .resume-surface-project {
    background:
      linear-gradient(
          180deg,
          rgba(110, 231, 183, 0.82),
          rgba(110, 231, 183, 0.18)
        )
        left top / 2px 100% no-repeat,
      rgba(4, 21, 17, 0.78);
  }

  .resume-panel {
    padding: 1.1rem;
  }

  .resume-panel-mirrored {
    padding: 1.1rem 1.16rem 1.1rem 1.1rem;
  }

  .resume-section {
    padding-top: 0;
    border-top: 0;
  }

  .resume-section-frame {
    position: relative;
    overflow: hidden;
    border: 0;
  }

  .resume-section-frame::before,
  .resume-section-frame::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: var(--resume-dossier-frame-depth);
    pointer-events: none;
    -webkit-mask-image: var(--resume-dossier-frame-fade);
    mask-image: var(--resume-dossier-frame-fade);
  }

  .resume-section-frame::before {
    top: 0;
    border-top: 1px dashed var(--resume-divider-strong);
    border-left: 1px dashed var(--resume-divider-strong);
    border-right: 1px dashed var(--resume-divider-strong);
    border-top-left-radius: var(--resume-panel-radius);
    border-top-right-radius: var(--resume-panel-radius);
  }

  .resume-section-frame::after {
    bottom: 0;
    border-bottom: 1px dashed var(--resume-divider-strong);
    border-left: 1px dashed var(--resume-divider-strong);
    border-right: 1px dashed var(--resume-divider-strong);
    border-bottom-left-radius: var(--resume-panel-radius);
    border-bottom-right-radius: var(--resume-panel-radius);
  }

  .resume-section-heading {
    margin-bottom: 1rem;
  }

  .resume-panel h2,
  .resume-section h2 {
    font-size: clamp(1.35rem, 2vw, 1.9rem);
  }

  .resume-section-heading p {
    margin: 0.45rem 0 0;
    line-height: 1.6;
    color: #bdeed8;
  }

  .resume-subheading {
    margin-top: 1.35rem !important;
  }

  .resume-facts {
    gap: 0.9rem;
    margin-top: 1.05rem;
  }

  .resume-facts > div,
  .resume-stack-list > div,
  .resume-project-meta > div {
    display: grid;
    gap: 0.2rem;
  }

  .resume-facts > div + div,
  .resume-stack-list > div + div {
    padding-top: 0.7rem;
    border-top: 1px dashed var(--resume-divider);
  }

  .resume-facts dt,
  .resume-project-meta dt,
  .resume-stack-list dt {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: #6ee7b7;
  }

  .resume-facts dd,
  .resume-project-meta dd,
  .resume-stack-list dd {
    margin: 0;
    line-height: 1.6;
    color: #d7fbec;
  }

  .resume-link-list,
  .resume-chip-list,
  .resume-skill-card ul,
  .resume-detail-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .resume-link-list {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.05rem;
  }

  .resume-link-card {
    display: grid;
    gap: 0.22rem;
    padding: 0.72rem 0.85rem;
    text-decoration: none;
    transition:
      color 170ms ease,
      transform 170ms ease,
      border-color 170ms ease,
      background-color 170ms ease;
  }

  .resume-link-card:hover {
    transform: translateX(2px);
    border-color: rgba(110, 231, 183, 0.28);
    background: rgba(6, 31, 24, 0.56);
  }

  .resume-link-list a span:first-child {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: #6ee7b7;
  }

  .resume-link-list a span:last-child {
    color: #d7fbec;
    line-height: 1.6;
    word-break: break-word;
  }

  .resume-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .resume-chip-list li {
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(110, 231, 183, 0.24);
    background: rgba(4, 20, 16, 0.52);
    color: #ecfdf5;
    line-height: 1.4;
  }

  .resume-card-heading {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-bottom: 0.85rem;
  }

  .resume-card-index {
    margin: 0;
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    color: #86efac;
    opacity: 0.92;
  }

  .resume-skill-card {
    padding: 1rem 1rem 1.05rem;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  .resume-skill-card h3 {
    font-size: 1.08rem;
  }

  .resume-skill-card ul {
    gap: 0.46rem;
  }

  .resume-skill-group-label {
    font-weight: 500;
    color: #ddfced;
  }

  .resume-skill-sublist {
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.2rem;
    column-gap: 0.35rem;
    margin-top: 0.32rem;
    margin-left: 0;
    padding-left: 0;
  }

  .resume-skill-sublist .resume-skill-sublist-item {
    position: static;
    padding-left: 0;
    font-size: 0.9em;
    line-height: 1.35;
    list-style: none;
  }

  .resume-skill-sublist .resume-skill-sublist-item::before {
    content: "·";
    display: inline-block;
    width: auto;
    height: auto;
    margin-right: 0.35rem;
    color: rgba(110, 231, 183, 0.85);
