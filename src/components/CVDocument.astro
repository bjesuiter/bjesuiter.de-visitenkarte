---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import profilePic from "../assets/2023-03-17_square_near_profilepic.jpeg";
import { getLocalizedCvContent, type CvLocale } from "../data/cv";
import CVIntro from "./CVIntro.astro";

interface Props {
  locale?: CvLocale;
}

const { locale = "de" } = Astro.props;
const content = getLocalizedCvContent(locale);
const profileImageAlt =
  locale === "de"
    ? "Porträt von Benjamin Jesuiter"
    : "Portrait of Benjamin Jesuiter";
const printHref = locale === "de" ? "/de/lebenslauf/drucken/" : "/en/cv/print/";
const autoPrintHref = `${printHref}?autoprint=1`;
const skillLevelDots = [1, 2, 3, 4, 5];
const getSkillLevel = (level?: number) => level ?? 3;
const skillLegend =
  locale === "de"
    ? [
        { level: 1, label: "Grundkenntnisse" },
        { level: 2, label: "Arbeitsfähig" },
        { level: 3, label: "Sicher" },
        { level: 4, label: "Fortgeschritten" },
        { level: 5, label: "Experte" },
      ]
    : [
        { level: 1, label: "Foundational" },
        { level: 2, label: "Working" },
        { level: 3, label: "Proficient" },
        { level: 4, label: "Advanced" },
        { level: 5, label: "Expert" },
      ];
---

<main class="cv-page">
  <article class="cv-sheet">
    <header class="cv-hero gap-4">
      <div class="cv-hero-copy gap-4">
        <div class="cv-hero-meta">
          <p class="cv-badge">{content.badge}</p>
          <a
            href={autoPrintHref}
            target="_blank"
            rel="noreferrer noopener"
            class="cv-print-link print:hidden"
          >
            <Icon name="ph:printer-fill" class="cv-print-link-icon" />
            <span>{content.navigation.printLabel}</span>
          </a>
        </div>
        <h1>{content.heading}</h1>
        <CVIntro locale={locale} />
      </div>

      <div class="cv-hero-media">
        <Image
          src={profilePic}
          alt={profileImageAlt}
          loading="eager"
          class="cv-hero-image"
        />
      </div>
    </header>

    <section class="cv-grid cv-top-grid cv-section-shell gap-4">
      <section class="cv-panel cv-surface cv-surface-strong">
        <h2>{content.factsTitle}</h2>
        <dl class="cv-facts gap-4">
          {
            content.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd class="text-balance">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="cv-panel cv-panel-mirrored cv-surface">
        <h2>{content.contactTitle}</h2>
        <ul class="cv-link-list">
          {
            content.contactLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noreferrer"
                  class="cv-link-card cv-surface-inset"
                >
                  <span class="cv-link-label">
                    <Icon name={link.icon} class="cv-link-icon" />
                    <span>{link.label}</span>
                  </span>
                  <span class="cv-link-url">
                    {link.href.replace(/^https?:\/\//, "")}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <h2 class="cv-subheading">{content.industriesTitle}</h2>
        <ul class="cv-chip-list">
          {content.industries.map((industry) => <li>{industry}</li>)}
        </ul>
      </section>
    </section>

    <section class="cv-section-shell cv-section cv-skills-section">
      <div class="cv-section-heading cv-skills-heading">
        <h2>{content.skillsTitle}</h2>
      </div>

      <div
        class="cv-skills-legend"
        aria-label={locale === "de"
          ? "Legende für Kompetenzstufen"
          : "Skill level legend"}
      >
        {
          skillLegend.map((entry) => (
            <div class="cv-skills-legend-item">
              <span class="cv-skill-rating" aria-hidden="true">
                {skillLevelDots.map((dot) => (
                  <span
                    class:list={[
                      "cv-skill-rating-dot",
                      dot <= entry.level && "is-active",
                    ]}
                  />
                ))}
              </span>
              <span>{entry.label}</span>
            </div>
          ))
        }
      </div>

      <div class="cv-skills-grid">
        {
          content.skillCategories.map((category) => (
            <section class="cv-skill-card">
              <div class="cv-card-heading">
                <h3>{category.title}</h3>
              </div>
              <ul class="gap-4">
                {category.items.map((item) =>
                  "items" in item ? (
                    <li
                      class:list={[
                        "cv-skill-group",
                        item.label === "Daily driver models" &&
                          "cv-skill-group-spaced",
                      ]}
                    >
                      <p class="cv-skill-group-label">{item.label}</p>
                      <ul class="cv-skill-sublist">
                        {item.items.map((subItem) => (
                          <li class="cv-skill-sublist-item cv-skill-rating-row">
                            <span>{subItem.text}</span>
                            <span class="cv-skill-rating-group">
                              {subItem.chip && (
                                <span class="cv-chip cv-skill-sublist-chip">
                                  {subItem.chip}
                                </span>
                              )}
                              <span
                                class="cv-skill-rating"
                                aria-label={`Level ${getSkillLevel(subItem.level)} of 5`}
                              >
                                {skillLevelDots.map((dot) => (
                                  <span
                                    class:list={[
                                      "cv-skill-rating-dot",
                                      dot <= getSkillLevel(subItem.level) &&
                                        "is-active",
                                    ]}
                                    aria-hidden="true"
                                  />
                                ))}
                              </span>
                            </span>
                          </li>
                        ))}
                      </ul>
                    </li>
                  ) : (
                    <li class="cv-skill-chip-row cv-skill-rating-row">
                      <span>{item.text}</span>
                      <span class="cv-skill-rating-group">
                        {item.chip && <span class="cv-chip">{item.chip}</span>}
                        <span
                          class="cv-skill-rating"
                          aria-label={`Level ${getSkillLevel(item.level)} of 5`}
                        >
                          {skillLevelDots.map((dot) => (
                            <span
                              class:list={[
                                "cv-skill-rating-dot",
                                dot <= getSkillLevel(item.level) && "is-active",
                              ]}
                              aria-hidden="true"
                            />
                          ))}
                        </span>
                      </span>
                    </li>
                  ),
                )}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <section class="cv-section-shell cv-section cv-project-history-section">
      <div class="cv-section-heading">
        <div>
          <h2 class="pl-1">{content.projectsTitle}</h2>
        </div>
      </div>

      <div class="cv-projects">
        {
          content.projects.map((project, index) => (
            <article class="cv-project-card cv-surface cv-surface-project">
              <header class="cv-project-header gap-4">
                <div class="cv-project-title-block gap-4">
                  <div class="cv-project-eyebrow">
                    <span class="cv-card-index">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <p class="cv-project-period">{project.period}</p>
                  </div>
                  <p class="cv-project-sector">{project.sector}</p>
                  <h3>{project.title}</h3>
                </div>

                <dl class="cv-project-meta gap-4">
                  {project.duration && (
                    <div class="cv-surface-inset">
                      <dt>{content.durationLabel}</dt>
                      <dd>{project.duration}</dd>
                    </div>
                  )}
                  {project.teamSize && (
                    <div class="cv-surface-inset">
                      <dt>{content.teamSizeLabel}</dt>
                      <dd>{project.teamSize}</dd>
                    </div>
                  )}
                  <div class="cv-surface-inset cv-project-meta-roles">
                    <dt>{content.rolesLabel}</dt>
                    <dd>{project.roles.join(" · ")}</dd>
                  </div>
                </dl>
              </header>

              <div class="cv-project-divider" aria-hidden="true" />

              <div class="cv-project-body gap-4">
                <div class="cv-project-copy gap-4">
                  <section class="cv-project-summary">
                    {project.summary.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </section>

                  <section class="cv-project-spacer" aria-hidden="true" />

                  <section class="cv-project-highlights">
                    <h4>{content.highlightsTitle}</h4>
                    <ul class="cv-project-highlights-list gap-4">
                      {project.highlights.map((highlight) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                  </section>
                </div>

                <section class="cv-detail-card cv-surface-inset cv-brace-frame-vertical">
                  <h4>{content.stackTitle}</h4>
                  <dl class="cv-stack-list gap-4">
                    {project.stack.map((item) => (
                      <div>
                        <dt>{item.label}</dt>
                        <dd>{item.value}</dd>
                      </div>
                    ))}
                  </dl>
                </section>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </article>
</main>

<!-- Global styles for the on-screen CV layout. -->
<style is:global>
  .cv-page {
    --cv-content-width: 1140px;
    --cv-page-padding: 0.8rem;
    --cv-dock-overlap: 8.25rem;
    --cv-divider: oklch(0.9049 0.0895 164.15 / 0.12);
    --cv-divider-strong: oklch(0.9049 0.0895 164.15 / 0.2);
    --cv-panel-radius: 14px;
    --cv-sheet-padding: 1.1rem;
    --cv-panel-border: oklch(0.9049 0.0895 164.15 / 0.14);
    --cv-dossier-frame-depth: calc(var(--cv-panel-radius) + 12px);
    --cv-dossier-frame-fade: linear-gradient(
      90deg,
      transparent 0%,
      oklch(0 0 0 / 0.2) 8%,
      oklch(0 0 0) 16%,
      oklch(0 0 0) 84%,
      oklch(0 0 0 / 0.2) 92%,
      transparent 100%
    );
    --cv-panel-surface: oklch(0.1861 0.0283 174.33 / 0.84);
    --cv-panel-surface-strong: oklch(0.2058 0.0319 169.79 / 0.9);
    min-height: 100vh;
    margin-top: calc(var(--cv-dock-overlap) * -1);
    padding: calc(var(--cv-page-padding) + var(--cv-dock-overlap))
      var(--cv-page-padding) var(--cv-page-padding);
    background: oklch(0.161 0.0255 175.92);
    color: oklch(0.9793 0.0207 166.11);
  }

  .cv-sheet {
    width: min(var(--cv-content-width), 100%);
    margin-inline: auto;
  }

  .cv-hero,
  .cv-hero-copy,
  .cv-grid,
  .cv-facts,
  .cv-skills-grid,
  .cv-projects,
  .cv-project-header,
  .cv-project-title-block,
  .cv-project-meta,
  .cv-project-body,
  .cv-project-copy,
  .cv-stack-list,
  .cv-project-highlights-list,
  .cv-skill-card ul,
  .cv-detail-card ul {
    display: grid;
  }

  .cv-badge,
  .cv-card-index,
  .cv-facts dt,
  .cv-project-meta dt,
  .cv-stack-list dt,
  .cv-project-period,
  .cv-link-label,
  .cv-print-link {
    font-family: "Chakra Petch", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
  }

  .cv-sheet {
    padding: 1.1rem;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid oklch(0.9049 0.0895 164.15 / 0.18);
    background: oklch(0.1787 0.0258 176.8 / 0.92);
    box-shadow: 0 24px 52px oklch(0.131 0.0212 174.91 / 0.42);
  }

  .cv-hero {
    gap: 1.15rem;
    margin: calc(var(--cv-sheet-padding) * -1)
      calc(var(--cv-sheet-padding) * -1) 0;
    padding: var(--cv-sheet-padding) var(--cv-sheet-padding) 1.6rem;
    background:
      linear-gradient(
          90deg,
          oklch(0.9624 0.0434 156.74 / 0.015) 1px,
          transparent 1px
        )
        0 0 / 34px 100%,
      oklch(0.1787 0.0258 176.8 / 0.92);
  }

  .cv-hero-copy {
    gap: 0.95rem;
    align-content: start;
  }

  .cv-hero-meta {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .cv-badge {
    margin: 0;
    font-size: 0.84rem;
    letter-spacing: 0.14em;
    color: oklch(0.8452 0.1299 164.98);
  }

  .cv-print-link {
    display: inline-flex;
    align-items: center;
    gap: 0.34rem;
    padding: 0.28rem 0.56rem;
    border: 1px solid oklch(0.8452 0.1299 164.98 / 0.18);
    border-radius: 999px;
    background: oklch(0.8452 0.1299 164.98 / 0.06);
    color: oklch(0.8452 0.1299 164.98 / 0.94);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    transition:
      transform 170ms ease,
      border-color 170ms ease,
      background-color 170ms ease,
      color 170ms ease;
  }

  .cv-print-link:hover {
    transform: translateY(-1px);
    border-color: oklch(0.8452 0.1299 164.98 / 0.34);
    background: oklch(0.8452 0.1299 164.98 / 0.12);
    color: oklch(0.9793 0.0207 166.11);
  }

  .cv-print-link-icon {
    flex: 0 0 auto;
    width: 0.82rem;
    height: 0.82rem;
  }

  .cv-hero h1,
  .cv-section h2,
  .cv-panel h2,
  .cv-project-card h3,
  .cv-project-highlights h4,
  .cv-detail-card h4,
  .cv-skill-card h3 {
    margin: 0;
    font-family: "Fraunces", serif;
    text-wrap: balance;
    color: oklch(0.9793 0.0207 166.11);
  }

  .cv-hero h1 {
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
  }

  .cv-intro {
    max-width: 72ch;
    margin: 0;
    font-size: clamp(1rem, 1.5vw, 1.08rem);
    line-height: 1.75;
    color: oklch(0.9277 0.0528 165.89);
  }

  .cv-intro p {
    margin: 0;
  }

  .cv-intro p + p {
    margin-top: 0.45rem;
  }

  .cv-intro strong {
    color: oklch(0.9793 0.0207 166.11);
  }

  .cv-hero-media {
    position: relative;
    min-height: 18rem;
    overflow: hidden;
    border-radius: 28px;
    border: 1px solid oklch(0.9049 0.0895 164.15 / 0.18);
    background: oklch(0.1873 0.0263 177.38 / 0.82);
    box-shadow: 0 24px 48px oklch(0.131 0.0212 174.91 / 0.28);
  }

  .cv-hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      oklch(0.158 0.0229 173.73 / 0.02) 0%,
      oklch(0.2038 0.036 165.86 / 0.18) 70%,
      oklch(0.158 0.0229 173.73 / 0.5) 100%
    );
  }

  .cv-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: saturate(0.88) contrast(1.04) brightness(1);
  }

  .cv-top-grid,
  .cv-section,
  .cv-skills-grid,
  .cv-projects {
    margin-top: 1rem;
  }

  .cv-surface {
    overflow: hidden;
    border: 1px solid var(--cv-panel-border);
    border-radius: var(--cv-panel-radius);
    background: var(--cv-panel-surface);
    box-shadow:
      inset 0 1px 0 oklch(1 0 89.88 / 0.04),
      0 14px 28px oklch(0.131 0.0212 174.91 / 0.16);
    backdrop-filter: blur(8px);
  }

  .cv-surface-inset {
    border: 1px solid oklch(0.9049 0.0895 164.15 / 0.12);
    border-radius: 16px;
    background: oklch(0.1748 0.0249 176.05 / 0.46);
    box-shadow: inset 0 1px 0 oklch(1 0 89.88 / 0.03);
  }

  .cv-surface-project {
    --cv-timeline-strip-color: oklch(0.8452 0.1299 164.98 / 0.42);
    --cv-timeline-strip-width: 2px;
    --cv-timeline-strip-wrap: 1.5rem;
    position: relative;
    border: 0;
    background: oklch(0.1787 0.0258 176.8 / 0.78);
  }

  .cv-surface-project::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--cv-timeline-strip-wrap) + var(--cv-timeline-strip-width));
    border-top: var(--cv-timeline-strip-width) solid
      var(--cv-timeline-strip-color);
    border-bottom: var(--cv-timeline-strip-width) solid
      var(--cv-timeline-strip-color);
    border-left: var(--cv-timeline-strip-width) solid
      var(--cv-timeline-strip-color);
    border-top-left-radius: var(--cv-panel-radius);
    border-bottom-left-radius: var(--cv-panel-radius);
    pointer-events: none;
    -webkit-mask-image: linear-gradient(
      90deg,
      oklch(0 0 0) 0,
      oklch(0 0 0) calc(100% - 0.92rem),
      oklch(0 0 0 / 0.72) calc(100% - 0.56rem),
      oklch(0 0 0 / 0.28) calc(100% - 0.18rem),
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      oklch(0 0 0) 0,
      oklch(0 0 0) calc(100% - 0.92rem),
      oklch(0 0 0 / 0.72) calc(100% - 0.56rem),
      oklch(0 0 0 / 0.28) calc(100% - 0.18rem),
      transparent 100%
    );
  }

  .cv-panel {
    padding: 1.1rem;
  }

  .cv-section-shell {
    padding-inline: 0;
  }

  .cv-panel-mirrored {
    padding: 1.1rem 1.16rem 1.1rem 1.1rem;
  }

  .cv-section {
    padding-top: 0;
    border-top: 0;
  }

  .cv-section-frame {
    position: relative;
    overflow: hidden;
    border: 0;
  }

  .cv-skills-section,
  .cv-project-history-section {
    padding-top: 1rem;
  }

  .cv-skills-section {
    --cv-section-clamp-depth: 0.78rem;
    --cv-section-clamp-inset-left: 1.1rem;
    --cv-section-clamp-inset-right: 1.1rem;
    padding-inline: 0.15rem;
  }

  .cv-section-frame::before,
  .cv-section-frame::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: var(--cv-dossier-frame-depth);
    pointer-events: none;
    -webkit-mask-image: var(--cv-dossier-frame-fade);
    mask-image: var(--cv-dossier-frame-fade);
  }

  .cv-section-frame::before {
    top: 0;
    border-top: 1px dashed var(--cv-divider-strong);
    border-left: 1px dashed var(--cv-divider-strong);
    border-right: 1px dashed var(--cv-divider-strong);
    border-top-left-radius: var(--cv-panel-radius);
    border-top-right-radius: var(--cv-panel-radius);
  }

  .cv-section-frame::after {
    bottom: 0;
    border-bottom: 1px dashed var(--cv-divider-strong);
    border-left: 1px dashed var(--cv-divider-strong);
    border-right: 1px dashed var(--cv-divider-strong);
    border-bottom-left-radius: var(--cv-panel-radius);
    border-bottom-right-radius: var(--cv-panel-radius);
  }

  .cv-skills-section.cv-section-frame::before,
  .cv-skills-section.cv-section-frame::after {
    left: var(--cv-section-clamp-inset-left);
    right: var(--cv-section-clamp-inset-right);
    height: var(--cv-section-clamp-depth);
    -webkit-mask-image: none;
    mask-image: none;
  }

  .cv-skills-section.cv-section-frame::before {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
  }

  .cv-skills-section.cv-section-frame::after {
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
  }

  .cv-section-heading {
    margin-bottom: 1rem;
  }

  .cv-skills-heading {
    margin-bottom: 1.25rem;
  }

  .cv-skills-heading h2 {
    position: relative;
    display: inline-block;
    padding: 0 0 0.6rem;
  }

  .cv-skills-heading h2::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: min(12rem, 100%);
    height: 2px;
    border-radius: 999px;
    background: oklch(0.8452 0.1299 164.98 / 0.72);
  }

  .cv-panel h2,
  .cv-section h2 {
    font-size: clamp(1.35rem, 2vw, 1.9rem);
  }

  .cv-section-heading p {
    margin: 0.45rem 0 0;
    line-height: 1.6;
    color: oklch(0.9089 0.0586 165.94);
  }

  .cv-subheading {
    margin-top: 1.35rem !important;
  }

  .cv-facts {
    gap: 0.9rem;
    margin-top: 1.05rem;
  }

  .cv-facts > div,
  .cv-stack-list > div,
  .cv-project-meta > div {
    display: grid;
    gap: 0.2rem;
  }

  .cv-facts > div + div,
  .cv-stack-list > div + div {
    padding-top: 0.7rem;
    border-top: 1px dashed var(--cv-divider);
  }

  .cv-facts dt,
  .cv-project-meta dt,
  .cv-stack-list dt {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: oklch(0.8452 0.1299 164.98);
  }

  .cv-facts dd,
  .cv-project-meta dd,
  .cv-stack-list dd {
    margin: 0;
    line-height: 1.6;
    color: oklch(0.9583 0.0422 168.36);
  }

  .cv-link-list,
  .cv-chip-list,
  .cv-skill-card ul,
  .cv-project-highlights-list,
  .cv-detail-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cv-link-list {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.05rem;
  }

  .cv-link-card {
    display: grid;
    gap: 0.22rem;
    padding: 0.72rem 0.85rem;
    text-decoration: none;
    transition:
      color 170ms ease,
      transform 170ms ease,
      border-color 170ms ease,
      background-color 170ms ease;
  }

  .cv-link-card:hover {
    transform: translateX(2px);
    border-color: oklch(0.8452 0.1299 164.98 / 0.28);
