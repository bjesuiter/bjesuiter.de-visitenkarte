---
interface Props {
  as?: "article" | "section" | "div";
  class?: string;
  borderStyle?: "solid" | "dashed";
}

const {
  as = "section",
  class: className = "",
  borderStyle = "solid",
} = Astro.props;

const Tag = as;
const baseClass =
  "w-full overflow-hidden rounded-[22px] border border-emerald-200/25 shadow-[0_24px_52px_rgba(1,10,7,0.55)]";
const baseStyle =
  "background: linear-gradient(90deg, rgba(220, 252, 231, 0.02) 1px, transparent 1px) 0 0 / 34px 100%, linear-gradient(0deg, rgba(220, 252, 231, 0.015) 1px, transparent 1px) 0 0 / 100% 34px, linear-gradient(135deg, rgba(7, 30, 24, 0.95), rgba(5, 24, 19, 0.84));";
---

<Tag
  class:list={[
    baseClass,
    borderStyle === "dashed" && "border-dashed",
    className,
  ]}
  style={baseStyle}
>
  <slot />
</Tag>
