---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import profilePic from "../../assets/2023-03-17_square_near_profilepic.jpeg";
import SurfaceCard from "../ui/SurfaceCard.astro";
import {
  getLocalizedProfileContent,
  type SupportedLocale,
} from "../../data/profiles";

interface Props {
  locale?: SupportedLocale;
  supportHref?: string;
  cvHref?: string;
}

const {
  locale = "de",
  supportHref = "/support",
  cvHref = "/de/lebenslauf",
} = Astro.props;
const { identity, profileSections, supportCta } =
  getLocalizedProfileContent(locale);
const profileAriaLabel = locale === "de" ? "Profile" : "Profiles";
const openLabel = locale === "de" ? "öffnen" : "open";
const verificationContent =
  locale === "de"
    ? {
        ariaLabel: "Verifizierung",
        title: "Verifizierung",
        description:
          "Über diese Website kann ich beweisen, dass ich die angegebenen Domains und Social-Accounts kontrolliere. Dafür nutze ich atproto.",
      }
    : {
        ariaLabel: "Verification",
        title: "Verification",
        description:
          "This website can be used to prove that I control the domains and social accounts listed here. It uses atproto for that.",
      };
// Intentionally hidden while the verification service is offline.
// Do not clean this up in future cleanup/refactor passes — it will likely be reactivated.
const showVerificationSection = false;
const cvCta =
  locale === "de"
    ? {
        ariaLabel: "Lebenslauf",
        title: "Vollständiger Lebenslauf",
        description:
          "Meine komplette Projektchronik, Kompetenzen und Branchenerfahrung gibt es jetzt auch direkt auf der Website – optimiert zum Lesen und zum Ausdrucken als PDF.",
        linkLabel: "Lebenslauf öffnen",
      }
    : {
        ariaLabel: "CV",
        title: "Full CV",
        description:
          "My complete project history, core skills, and industry background are now available directly on the website and optimized for reading or printing as a PDF.",
        linkLabel: "Open CV",
      };

const heroClass =
  "relative isolate grid min-h-[clamp(320px,78vw,440px)] items-end overflow-hidden border-b border-dashed border-emerald-200/30 p-[clamp(1.1rem,3.8vw,2rem)] min-[641px]:min-h-[clamp(360px,50vw,460px)] min-[641px]:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] min-[641px]:items-center min-[641px]:p-[clamp(1.25rem,3.2vw,2rem)] before:absolute before:inset-0 before:z-[1] before:bg-[radial-gradient(circle_at_18%_18%,rgba(110,231,183,0.16),transparent_32%),linear-gradient(180deg,rgba(3,16,12,0.04)_0%,rgba(6,32,22,0.14)_42%,rgba(4,28,19,0.5)_72%,rgba(3,16,12,0.86)_100%)] min-[641px]:before:bg-[linear-gradient(90deg,rgba(3,16,12,0.18)_0%,rgba(3,16,12,0.12)_42%,rgba(3,16,12,0.22)_52%,rgba(3,16,12,0.08)_66%,rgba(3,16,12,0)_82%)]";
const sectionClass =
  "grid gap-[0.85rem] border-t border-dashed border-emerald-200/20 p-[clamp(1.2rem,3vw,1.8rem)]";
const sectionTitleClass =
  "font-display text-[clamp(1.2rem,2vw,1.55rem)] leading-[1.1] text-balance text-emerald-50";
const supportTitleClass =
  "font-display text-[clamp(1.3rem,2.2vw,1.7rem)] leading-[1.1] text-balance text-emerald-50";
const sectionTextClass =
  "max-w-[60ch] font-tech leading-[1.5] text-[#c9f7e3] text-balance";
const ctaLinkBaseClass =
  "w-fit rounded-full border px-[1.05rem] py-[0.55rem] font-tech text-sm font-bold uppercase tracking-[0.04em] transition duration-200 ease-out hover:-translate-y-px focus-visible:-translate-y-px focus-visible:outline-none";
const profileLinkClass =
  "grid grid-cols-[auto_1fr_auto] items-center gap-[0.6rem] rounded-xl border border-emerald-300/30 bg-[rgba(2,20,15,0.42)] px-[0.8rem] py-[0.65rem] font-tech text-emerald-50 transition duration-200 hover:border-emerald-300 focus-visible:border-emerald-300 focus-visible:outline-none";
---

<SurfaceCard as="article" class="mx-auto max-w-[1140px]">
  <header class={heroClass}>
    <Image
      src={profilePic}
      alt={identity.imageAlt}
      loading="lazy"
      class="pointer-events-none absolute inset-0 z-0 h-full w-full object-cover object-top brightness-[0.98] contrast-[1.03] saturate-[0.84] min-[641px]:left-auto min-[641px]:w-1/2 min-[641px]:object-[center_10%] min-[951px]:top-4 min-[951px]:right-4 min-[951px]:bottom-auto min-[951px]:left-auto min-[951px]:h-[calc(100%-2rem)] min-[951px]:w-[min(420px,calc(46%_-_1rem))] min-[951px]:rounded-[18px] min-[951px]:object-[center_12%]"
    />
    <div
      class="relative z-[2] max-w-[54ch] text-center min-[641px]:col-start-1 min-[641px]:max-w-[30ch] min-[641px]:self-center min-[641px]:pr-[clamp(0.5rem,1.8vw,1.25rem)] min-[641px]:text-left"
    >
      <h1
        class="font-display mb-2 text-[clamp(2rem,6.2vw,3.4rem)] leading-[0.96] text-balance text-emerald-50"
      >
        {identity.name}
      </h1>
      <p
        class="font-tech mx-auto max-w-[34ch] text-[clamp(0.95rem,2vw,1.15rem)] leading-[1.5] text-balance text-emerald-100 min-[641px]:mx-0 min-[641px]:max-w-[24ch] min-[641px]:text-left"
      >
        {identity.tagline}
      </p>
    </div>
  </header>

  <section class="grid" aria-label={profileAriaLabel}>
    {
      profileSections.map((section, sectionIndex) => (
        <section
          class="motion-safe:animate-v5-enter grid border-b border-dashed border-emerald-200/18 last:border-b-0 min-[900px]:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)]"
          style={`animation-delay:${sectionIndex * 90}ms;`}
        >
          <aside class="p-[1.35rem] pb-[0.75rem] min-[900px]:border-r min-[900px]:border-dashed min-[900px]:border-emerald-200/15 min-[900px]:pb-[1.35rem]">
            <h2 class="font-display mt-[0.3rem] mb-[0.6rem] text-[clamp(1.15rem,2vw,1.45rem)] leading-[1.2] text-balance text-emerald-50">
              {section.title}
            </h2>
            <p class="font-tech leading-[1.5] text-balance text-[#bdeed8]">
              {section.description}
            </p>
          </aside>
          <ul class="grid list-none gap-[0.65rem] p-[1.35rem] pt-[0.7rem]">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noreferrer"
                  class={profileLinkClass}
                >
                  <Icon
                    name={link.icon}
                    class="size-[1.05rem] min-w-[1.05rem] text-emerald-300"
                  />
                  <span>{link.label}</span>
                  <span
                    aria-hidden="true"
                    class="hidden text-[0.65rem] tracking-[0.08em] text-emerald-200 uppercase min-[380px]:block"
                  >
                    {openLabel}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </section>

  <section
    class:list={[
      sectionClass,
      "bg-[radial-gradient(circle_at_12%_16%,rgba(110,231,183,0.16),transparent_30%),linear-gradient(120deg,rgba(4,27,21,0.96),rgba(6,34,25,0.82))]",
    ]}
    aria-label={cvCta.ariaLabel}
  >
    <h2 class={sectionTitleClass}>{cvCta.title}</h2>
    <p class={sectionTextClass}>{cvCta.description}</p>
    <a
      href={cvHref}
      class:list={[
        ctaLinkBaseClass,
        "border-white/24 bg-[linear-gradient(90deg,#a7f3d0,#6ee7b7)] text-[#032015] hover:brightness-[1.04] focus-visible:brightness-[1.04]",
      ]}
    >
      {cvCta.linkLabel}
    </a>
  </section>

  {
    showVerificationSection && (
      <section
        class:list={[
          sectionClass,
          "bg-[radial-gradient(circle_at_90%_20%,rgba(110,231,183,0.12),transparent_30%),linear-gradient(120deg,rgba(5,26,20,0.92),rgba(5,30,22,0.72))]",
        ]}
        aria-label={verificationContent.ariaLabel}
      >
        <h2 class={sectionTitleClass}>{verificationContent.title}</h2>
        <p class={sectionTextClass}>{verificationContent.description}</p>
        <a
          href="https://keytrace.dev/@bjesuiter.de"
          target="_blank"
          rel="noreferrer"
          class:list={[
            ctaLinkBaseClass,
            "border-emerald-300/50 bg-[rgba(3,24,18,0.6)] text-[#d9f9ec] hover:border-emerald-300 focus-visible:border-emerald-300",
          ]}
        >
          keytrace.dev/@bjesuiter.de
        </a>
      </section>
    )
  }

  <section
    class:list={[
      sectionClass,
      "bg-[radial-gradient(circle_at_10%_10%,rgba(110,231,183,0.14),transparent_28%),linear-gradient(120deg,rgba(4,24,18,0.9),rgba(5,30,22,0.7))]",
    ]}
    aria-label={supportCta.ariaLabel}
  >
    <h2 class={supportTitleClass}>{supportCta.title}</h2>
    <p class={sectionTextClass}>{supportCta.description}</p>
    <a
      href={supportHref}
      class:list={[
        ctaLinkBaseClass,
        "border-white/24 bg-[linear-gradient(90deg,#6ee7b7,#34d399)] text-[#032015] shadow-[0_8px_26px_rgba(0,0,0,0.26)] hover:brightness-[1.06] focus-visible:brightness-[1.06]",
      ]}
    >
      {supportCta.linkLabel}
    </a>
  </section>
</SurfaceCard>
