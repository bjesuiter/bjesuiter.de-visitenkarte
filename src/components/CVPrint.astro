---
import { Image } from "astro:assets";
import profilePic from "../assets/2023-03-17_square_near_profilepic.jpeg";
import { getLocalizedCvContent, type CvLocale } from "../data/cv";
import CVIntro from "./CVIntro.astro";

interface Props {
  locale?: CvLocale;
}

const { locale = "de" } = Astro.props;
const content = getLocalizedCvContent(locale);
const profileImageAlt =
  locale === "de"
    ? "Porträt von Benjamin Jesuiter"
    : "Portrait of Benjamin Jesuiter";
const lastUpdatedLabel = locale === "de" ? "Stand" : "Updated";
const parsedLastUpdated = new Date(`${content.lastUpdated}T00:00:00`);
const formattedLastUpdated = Number.isNaN(parsedLastUpdated.getTime())
  ? content.lastUpdated
  : new Intl.DateTimeFormat(locale === "de" ? "de-DE" : "en-GB", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    }).format(parsedLastUpdated);
type CvPrintProjectMode = "full" | "summary" | "stack";
const toIndexedPageItems = <T,>(items: T[], indices: number[]) =>
  indices.flatMap((index) => {
    const item = items[index];
    return item ? [{ index, item }] : [];
  });
const paginatedSkillPages = [
  toIndexedPageItems(content.skillCategories, [0, 1, 2, 3, 4]),
  toIndexedPageItems(content.skillCategories, [5, 6, 7, 8]),
].filter((page) => page.length > 0);
const paginatedProjectPages = [
  {
    showHeading: true,
    entries: [{ index: 0, mode: "full" }],
  },
  {
    showHeading: false,
    entries: [{ index: 1, mode: "full" }],
  },
  {
    showHeading: false,
    entries: [{ index: 2, mode: "summary" }],
  },
  {
    showHeading: false,
    entries: [{ index: 2, mode: "stack" }],
  },
  {
    showHeading: false,
    entries: [{ index: 3, mode: "summary" }],
  },
  {
    showHeading: false,
    entries: [{ index: 3, mode: "stack" }],
  },
  {
    showHeading: false,
    entries: [{ index: 4, mode: "full" }],
  },
  {
    showHeading: false,
    entries: [{ index: 5, mode: "full" }],
  },
  {
    showHeading: false,
    entries: [{ index: 6, mode: "full" }],
  },
  {
    showHeading: false,
    entries: [{ index: 7, mode: "summary" }],
  },
  {
    showHeading: false,
    entries: [{ index: 7, mode: "stack" }],
  },
  {
    showHeading: false,
    entries: [{ index: 8, mode: "summary" }],
  },
  {
    showHeading: false,
    entries: [{ index: 8, mode: "stack" }],
  },
  {
    showHeading: false,
    entries: [{ index: 9, mode: "summary" }],
  },
  {
    showHeading: false,
    entries: [{ index: 9, mode: "stack" }],
  },
  {
    showHeading: false,
    entries: [{ index: 10, mode: "summary" }],
  },
  {
    showHeading: false,
    entries: [{ index: 10, mode: "stack" }],
  },
  {
    showHeading: false,
    entries: [{ index: 11, mode: "full" }],
  },
  {
    showHeading: false,
    entries: [{ index: 12, mode: "full" }],
  },
  {
    showHeading: false,
    entries: [{ index: 13, mode: "full" }],
  },
  {
    showHeading: false,
    entries: [{ index: 14, mode: "full" }],
  },
]
  .map((page) => ({
    ...page,
    entries: page.entries.flatMap(
      ({ index, mode }: { index: number; mode: CvPrintProjectMode }) => {
        const project = content.projects[index];
        return project ? [{ index, mode, project }] : [];
      },
    ),
  }))
  .filter((page) => page.entries.length > 0);
---

<main class="cv-page">
  <div class="cv-print-stack">
    <article class="cv-print-page cv-print-page-hero">
      <div class="cv-sheet cv-sheet-page">
        <header class="cv-hero gap-4">
          <div class="cv-hero-head gap-4">
            <div class="cv-hero-meta">
              <p class="cv-badge">{content.badge}</p>
              <p class="cv-last-updated">
                <span>{lastUpdatedLabel}</span>
                <time datetime={content.lastUpdated}>{formattedLastUpdated}</time>
              </p>
            </div>
            <h1>{content.heading}</h1>
          </div>

          <div class="cv-hero-media">
            <Image
              src={profilePic}
              alt={profileImageAlt}
              loading="eager"
              class="cv-hero-image"
            />
          </div>

          <div class="cv-hero-intro">
            <CVIntro locale={locale} />
          </div>
        </header>

        <section class="cv-section-shell cv-print-hero-links">
          <section class="cv-panel cv-panel-mirrored cv-surface">
            <h2>{content.contactTitle}</h2>
            <ul class="cv-link-list">
              {
                content.contactLinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noreferrer"
                      class="cv-link-card cv-surface-inset"
                    >
                      <span>{link.label}</span>
                      <span>{link.href.replace(/^https?:\/\//, "")}</span>
                    </a>
                  </li>
                ))
              }
            </ul>

            <h2 class="cv-subheading">{content.industriesTitle}</h2>
            <ul class="cv-chip-list">
              {content.industries.map((industry) => <li>{industry}</li>)}
            </ul>
          </section>
        </section>
      </div>
    </article>

    <article class="cv-print-page cv-print-page-overview">
      <div class="cv-sheet cv-sheet-page">
        <section class="cv-section-shell">
          <section class="cv-panel cv-surface cv-surface-strong">
            <h2>{content.factsTitle}</h2>
            <dl class="cv-facts cv-print-overview-facts gap-4">
              {
                content.facts.map((fact) => (
                  <div>
                    <dt>{fact.label}</dt>
                    <dd class="text-balance">{fact.value}</dd>
                  </div>
                ))
              }
            </dl>
          </section>
        </section>
      </div>
    </article>

    {
      paginatedSkillPages.map((skillPage) => (
        <article class="cv-print-page cv-print-page-skills">
          <div class="cv-sheet cv-sheet-page">
            <section class="cv-section-shell cv-section cv-skills-section">
              <div class="cv-section-heading">
                <h2 class="pl-2">{content.skillsTitle}</h2>
              </div>

              <div class="cv-skills-grid gap-4">
                {skillPage.map(({ item: category }) => (
                  <section class="cv-skill-card">
                    <div class="cv-card-heading">
                      <h3>{category.title}</h3>
                    </div>
                    <ul class="gap-4">
                      {category.items.map((item) =>
                        typeof item === "string" ? (
                          <li>{item}</li>
                        ) : "items" in item ? (
                          <li class="cv-skill-group">
                            <span class="cv-skill-group-label">
                              <span
                                class="cv-skill-group-dot"
                                aria-hidden="true"
                              />
                              <span>{item.label}</span>
                            </span>
                            <ul class="cv-skill-sublist">
                              {item.items.map((subItem) => (
                                <li class="cv-skill-sublist-item">{subItem}</li>
                              ))}
                            </ul>
                          </li>
                        ) : (
                          <li class="cv-skill-chip-row">
                            <span>{item.text}</span>
                            <span class="cv-chip">{item.chip}</span>
                          </li>
                        ),
                      )}
                    </ul>
                  </section>
                ))}
              </div>
            </section>
          </div>
        </article>
      ))
    }

    {
      paginatedProjectPages.map((projectPage) => (
        <article class="cv-print-page cv-print-page-projects">
          <div class="cv-sheet cv-sheet-page">
            {projectPage.showHeading && (
              <section class="cv-section-shell cv-section cv-project-history-section">
                <div class="cv-section-heading">
                  <div>
                    <h2 class="pl-1">{content.projectsTitle}</h2>
                  </div>
                </div>
              </section>
            )}

            <div class="cv-projects">
              {projectPage.entries.map(({ project, index, mode }) => (
                <article
                  class:list={[
                    "cv-project-card cv-surface cv-surface-project",
                    mode === "stack" && "cv-project-card-stack",
                  ]}
                >
                  <header class="cv-project-header gap-4">
                    <div class="cv-project-title-block gap-4">
                      <div class="cv-project-eyebrow">
                        <span class="cv-card-index">
                          {String(index + 1).padStart(2, "0")}
                        </span>
                        <p class="cv-project-period">{project.period}</p>
                      </div>
                      <p class="cv-project-sector">{project.sector}</p>
                      <h3>{project.title}</h3>
                      {mode === "stack" && (
                        <p class="cv-project-page-kicker">
                          {content.stackTitle}
                        </p>
                      )}
                    </div>

                    <dl class="cv-project-meta gap-4">
                      {project.duration && (
                        <div class="cv-surface-inset">
                          <dt>{content.durationLabel}</dt>
                          <dd>{project.duration}</dd>
                        </div>
                      )}
                      {project.teamSize && (
                        <div class="cv-surface-inset">
                          <dt>{content.teamSizeLabel}</dt>
                          <dd>{project.teamSize}</dd>
                        </div>
                      )}
                      <div class="cv-surface-inset cv-project-meta-roles">
                        <dt>{content.rolesLabel}</dt>
                        <dd>{project.roles.join(" · ")}</dd>
                      </div>
                    </dl>
                  </header>

                  <div class="cv-project-divider" aria-hidden="true" />

                  {mode === "stack" ? (
                    <section class="cv-project-stack-page">
                      <section class="cv-detail-card cv-surface-inset cv-brace-frame-vertical">
                        <h4>{content.stackTitle}</h4>
                        <dl class="cv-stack-list gap-4">
                          {project.stack.map((item) => (
                            <div>
                              <dt>{item.label}</dt>
                              <dd>{item.value}</dd>
                            </div>
                          ))}
                        </dl>
                      </section>
                    </section>
                  ) : (
                    <div
                      class:list={[
                        "cv-project-body gap-4",
                        mode === "summary" && "cv-project-body-summary",
                      ]}
                    >
                      <div class="cv-project-copy gap-4">
                        <section class="cv-project-summary">
                          {project.summary.map((paragraph) => (
                            <p>{paragraph}</p>
                          ))}
                        </section>

                        <section class="cv-project-spacer" aria-hidden="true" />

                        <section class="cv-project-highlights">
                          <h4>{content.highlightsTitle}</h4>
                          <ul class="cv-project-highlights-list gap-4">
                            {project.highlights.map((highlight) => (
                              <li>{highlight}</li>
                            ))}
                          </ul>
                        </section>
                      </div>

                      {mode === "full" && (
                        <section class="cv-detail-card cv-surface-inset cv-brace-frame-vertical">
                          <h4>{content.stackTitle}</h4>
                          <dl class="cv-stack-list gap-4">
                            {project.stack.map((item) => (
                              <div>
                                <dt>{item.label}</dt>
                                <dd>{item.value}</dd>
                              </div>
                            ))}
                          </dl>
                        </section>
                      )}
                    </div>
                  )}
                </article>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</main>

<!-- Inline script that switches styling modes before printing or downloading the CV. -->
<script is:inline>
  (() => {
    const OVERFLOW_TOLERANCE_PX = 1;

    const syncPrintActiveState = () => {
      const root = document.documentElement;
      const isPreview = root.hasAttribute("data-print-preview");

      if (isPreview) {
        root.dataset.cvPrintActive = "true";
        document.body?.setAttribute("data-cv-print-active", "true");
        return;
      }

      delete root.dataset.cvPrintActive;
      document.body?.removeAttribute("data-cv-print-active");
    };

    const collectPrintOverflow = () => {
      const pages = Array.from(document.querySelectorAll(".cv-print-page"));

      return pages.map((page, index) => {
        const sheet = page.querySelector(".cv-sheet-page");

        if (!(sheet instanceof HTMLElement)) {
          return {
            pageNumber: index + 1,
            overflow: false,
            overflowPx: 0,
            bottomOverflowPx: 0,
            rightOverflowPx: 0,
            overflowSamples: [],
          };
        }

        const describeElement = (element) => {
          const classes =
            typeof element.className === "string"
              ? element.className
                  .split(/\s+/)
                  .filter(Boolean)
                  .slice(0, 2)
                  .join(".")
              : "";

          return `${element.tagName.toLowerCase()}${classes ? `.${classes}` : ""}`;
        };

        const sheetRect = sheet.getBoundingClientRect();
        const sheetStyle = window.getComputedStyle(sheet);
        const paddingBottom = Number.parseFloat(sheetStyle.paddingBottom) || 0;
        const paddingRight = Number.parseFloat(sheetStyle.paddingRight) || 0;
        const visibleBottom = sheetRect.bottom - paddingBottom;
        const visibleRight = sheetRect.right - paddingRight;
        const scrollBottomOverflow = Math.max(
          0,
          sheet.scrollHeight - sheet.clientHeight,
        );
        const scrollRightOverflow = Math.max(
          0,
          sheet.scrollWidth - sheet.clientWidth,
        );
        const descendantOverflow = Array.from(sheet.querySelectorAll("*")).reduce(
          (summary, element) => {
            if (!(element instanceof HTMLElement)) {
              return summary;
            }

            const rect = element.getBoundingClientRect();
            const bottomOverflow = Math.max(0, rect.bottom - visibleBottom);
            const rightOverflow = Math.max(0, rect.right - visibleRight);
            const elementOverflow = Math.max(bottomOverflow, rightOverflow);

            if (elementOverflow <= OVERFLOW_TOLERANCE_PX) {
              return summary;
            }

            const nextSamples =
              summary.samples.length < 3
                ? [
                    ...summary.samples,
                    {
                      element: describeElement(element),
                      bottomOverflowPx: Number(bottomOverflow.toFixed(2)),
                      rightOverflowPx: Number(rightOverflow.toFixed(2)),
                    },
                  ]
                : summary.samples;

            return {
              bottomOverflowPx: Math.max(summary.bottomOverflowPx, bottomOverflow),
              rightOverflowPx: Math.max(summary.rightOverflowPx, rightOverflow),
              samples: nextSamples,
            };
          },
          { bottomOverflowPx: 0, rightOverflowPx: 0, samples: [] },
        );
        const bottomOverflowPx = Math.max(
          scrollBottomOverflow,
          descendantOverflow.bottomOverflowPx,
        );
        const rightOverflowPx = Math.max(
          scrollRightOverflow,
          descendantOverflow.rightOverflowPx,
        );
        const overflowPx = Math.max(bottomOverflowPx, rightOverflowPx);

        return {
          pageNumber: index + 1,
          overflow: overflowPx > OVERFLOW_TOLERANCE_PX,
          overflowPx: Number(overflowPx.toFixed(2)),
          bottomOverflowPx: Number(bottomOverflowPx.toFixed(2)),
          rightOverflowPx: Number(rightOverflowPx.toFixed(2)),
          overflowSamples: descendantOverflow.samples,
        };
      });
    };

    const syncPrintOverflowState = () => {
      const root = document.documentElement;
      const isPreview = root.hasAttribute("data-print-preview");
      const pages = Array.from(document.querySelectorAll(".cv-print-page"));

      if (!isPreview || pages.length === 0) {
        delete root.dataset.cvOverflowActive;
        window.__cvMeasurePrintOverflow = undefined;
        window.__cvPrintOverflowState = [];
        pages.forEach((page) => {
          delete page.dataset.cvOverflow;
          delete page.dataset.cvOverflowPx;
          delete page.dataset.cvPageNumber;
        });
        return;
      }

      const overflowState = collectPrintOverflow();
      const overflowPages = overflowState.filter((page) => page.overflow);

      root.dataset.cvOverflowActive =
        overflowPages.length > 0 ? "true" : "false";
      window.__cvMeasurePrintOverflow = () => collectPrintOverflow();
      window.__cvPrintOverflowState = overflowState;

      pages.forEach((page, index) => {
        const state = overflowState[index];

        if (!state) {
          return;
        }

        page.dataset.cvPageNumber = String(state.pageNumber);
        page.dataset.cvOverflow = state.overflow ? "true" : "false";
        page.dataset.cvOverflowPx = state.overflowPx.toFixed(1);
      });

      if (overflowPages.length > 0) {
        console.warn(
          "[cv-print-overflow] Overflow detected:",
          overflowPages.map((page) => ({
            page: page.pageNumber,
            overflowPx: page.overflowPx,
            bottomOverflowPx: page.bottomOverflowPx,
            rightOverflowPx: page.rightOverflowPx,
            overflowSamples: page.overflowSamples,
          })),
        );
      }
    };

    let overflowFrame = 0;
    const schedulePrintOverflowSync = () => {
      if (overflowFrame !== 0) {
        cancelAnimationFrame(overflowFrame);
      }

      overflowFrame = window.requestAnimationFrame(() => {
        overflowFrame = window.requestAnimationFrame(() => {
          overflowFrame = 0;
          syncPrintOverflowState();
        });
      });
    };

    const setMode = (mode) => {
      document.documentElement.setAttribute("cata-cv-output", mode);
      document.body?.setAttribute("cata-cv-output", mode);
      document.documentElement.dataset.cvPrintActive = "true";
      document.body?.setAttribute("data-cv-print-active", "true");
    };

    const clearMode = () => {
      document.documentElement.removeAttribute("cata-cv-output");
      document.body?.removeAttribute("cata-cv-output");
      syncPrintActiveState();
    };

    window.__cvPrintMode = (mode) => {
      setMode(mode);
      window.print();
    };

    window.addEventListener("beforeprint", () => {
      document.documentElement.dataset.cvPrintActive = "true";
      document.body?.setAttribute("data-cv-print-active", "true");
    });
    window.addEventListener("afterprint", clearMode);
    syncPrintActiveState();
    schedulePrintOverflowSync();
    window.addEventListener("load", schedulePrintOverflowSync);
    window.addEventListener("resize", schedulePrintOverflowSync);

    document.fonts?.ready.then(schedulePrintOverflowSync).catch(() => {});

    document.querySelectorAll("img").forEach((image) => {
      if (image.complete) {
        return;
      }

      image.addEventListener("load", schedulePrintOverflowSync, {
        once: true,
      });
      image.addEventListener("error", schedulePrintOverflowSync, {
        once: true,
      });
    });
  })();
</script>

<!-- Global styles for the on-screen cv layout and print/download output. -->
<style is:global>
  .cv-page {
    --cv-content-width: 1140px;
    --cv-page-padding: 0.8rem;
    --cv-dock-overlap: 8.25rem;
    --cv-divider: oklch(0.9049 0.0895 164.15 / 0.12);
    --cv-divider-strong: oklch(0.9049 0.0895 164.15 / 0.2);
    --cv-panel-radius: 14px;
    --cv-sheet-padding: 1.1rem;
    --cv-panel-border: oklch(0.9049 0.0895 164.15 / 0.14);
    --cv-dossier-frame-depth: calc(var(--cv-panel-radius) + 12px);
    --cv-dossier-frame-fade: linear-gradient(
      90deg,
      transparent 0%,
      oklch(0 0 0 / 0.2) 8%,
      oklch(0 0 0) 16%,
      oklch(0 0 0) 84%,
      oklch(0 0 0 / 0.2) 92%,
      transparent 100%
    );
    --cv-panel-surface: oklch(0.1861 0.0283 174.33 / 0.84);
    --cv-panel-surface-strong: oklch(0.2058 0.0319 169.79 / 0.9);
    min-height: 100vh;
    margin-top: calc(var(--cv-dock-overlap) * -1);
    padding: calc(var(--cv-page-padding) + var(--cv-dock-overlap))
      var(--cv-page-padding) var(--cv-page-padding);
    background: oklch(0.161 0.0255 175.92);
    color: oklch(0.9793 0.0207 166.11);
  }

  .cv-sheet {
    width: min(var(--cv-content-width), 100%);
    margin-inline: auto;
  }

  .cv-print-stack {
    display: grid;
  }

  .cv-print-page {
    width: 100%;
    margin-inline: auto;
  }

  .cv-sheet-page {
    min-height: 100%;
  }

  .cv-hero,
  .cv-hero-head,
  .cv-hero-intro,
  .cv-grid,
  .cv-facts,
  .cv-skills-grid,
  .cv-projects,
  .cv-project-header,
  .cv-project-title-block,
  .cv-project-meta,
  .cv-project-body,
  .cv-project-copy,
  .cv-stack-list,
  .cv-project-highlights-list,
  .cv-skill-card ul,
  .cv-detail-card ul {
    display: grid;
  }

  .cv-badge,
  .cv-last-updated span,
  .cv-card-index,
  .cv-facts dt,
  .cv-project-meta dt,
  .cv-stack-list dt,
  .cv-project-period,
  .cv-link-list a span:first-child {
    font-family: "Chakra Petch", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
  }

  .cv-sheet {
    padding: 1.1rem;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid oklch(0.9049 0.0895 164.15 / 0.18);
    background: oklch(0.1787 0.0258 176.8 / 0.92);
    box-shadow: 0 24px 52px oklch(0.131 0.0212 174.91 / 0.42);
  }

  .cv-hero {
    gap: 1.15rem;
    margin: calc(var(--cv-sheet-padding) * -1)
      calc(var(--cv-sheet-padding) * -1) 0;
    padding: var(--cv-sheet-padding) var(--cv-sheet-padding) 1.6rem;
    background:
      linear-gradient(
          90deg,
          oklch(0.9624 0.0434 156.74 / 0.015) 1px,
          transparent 1px
        )
        0 0 / 34px 100%,
      oklch(0.1787 0.0258 176.8 / 0.92);
  }

  .cv-hero-head {
    gap: 0.95rem;
    align-content: start;
  }

  .cv-hero-intro {
    align-content: start;
  }

  .cv-hero-meta {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .cv-badge {
    margin: 0;
    font-size: 0.84rem;
    letter-spacing: 0.14em;
    color: oklch(0.8452 0.1299 164.98);
  }

  .cv-last-updated {
    margin: 0;
    display: grid;
    justify-items: end;
    gap: 0.12rem;
    text-align: right;
  }

  .cv-last-updated span {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: oklch(0.8452 0.1299 164.98);
  }

  .cv-last-updated time {
    color: oklch(0.9583 0.0422 168.36);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .cv-hero h1,
  .cv-section h2,
  .cv-panel h2,
  .cv-project-card h3,
  .cv-project-highlights h4,
  .cv-detail-card h4,
  .cv-skill-card h3 {
    margin: 0;
    font-family: "Fraunces", serif;
    text-wrap: balance;
    color: oklch(0.9793 0.0207 166.11);
  }

  .cv-hero h1 {
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
  }

  .cv-intro {
    max-width: 72ch;
    margin: 0;
    font-size: clamp(1rem, 1.5vw, 1.08rem);
    line-height: 1.75;
    color: oklch(0.9277 0.0528 165.89);
  }

  .cv-intro p {
    margin: 0;
  }

  .cv-intro p + p {
    margin-top: 0.45rem;
  }

  .cv-intro strong {
    color: oklch(0.9793 0.0207 166.11);
  }

  .cv-hero-head {
    grid-area: head;
  }

  .cv-hero-intro {
    grid-area: intro;
  }

  .cv-hero-media {
    grid-area: media;
    position: relative;
    min-height: 18rem;
    overflow: hidden;
    border-radius: 28px;
    border: 1px solid oklch(0.9049 0.0895 164.15 / 0.18);
