---
import DockNav from "../../components/DockNav.astro";
import Variant5 from "../../components/scratch/Variant5.astro";
import PageBackdrop from "../../components/ui/PageBackdrop.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout
  lang="de"
  title="Benjamin Jesuiter · bjesuiter.de"
  description="Persönliche Landingpage von Benjamin Jesuiter mit Dev-, Business- und Social-Links."
  bodyClass="bg-[#02110d]"
>
  <DockNav
    locale="de"
    current="home"
    homeHref="/de/"
    resumeHref="/de/lebenslauf/"
    supportHref="/de/support/"
    languageSwitchHref="/en/"
  />
  <PageBackdrop
    subtleGrid
    class="px-[clamp(1rem,2.4vw,2.1rem)] py-[clamp(1rem,2.4vw,2.1rem)]"
  >
    <Variant5
      locale="de"
      supportHref="/de/support/"
      resumeHref="/de/lebenslauf/"
    />
  </PageBackdrop>
</Layout>
