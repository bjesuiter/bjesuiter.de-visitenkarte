---
import DockNav from "../components/DockNav.astro";
import SupportCard from "../components/SupportCard.astro";
import PageBackdrop from "../components/ui/PageBackdrop.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Support · bjesuiter.de"
  description="Support-Seite von Benjamin Jesuiter."
  bodyClass="bg-[#02110d]"
>
  <DockNav
    locale="de"
    current="support"
    homeHref="/"
    resumeHref="/de/lebenslauf/"
    supportHref="/support/"
    languageSwitchHref="/en/support/"
  />
  <PageBackdrop
    centered
    class="px-[clamp(1rem,3vw,2rem)] py-[clamp(1rem,3vw,2rem)]"
  >
    <SupportCard locale="de" />
  </PageBackdrop>
</Layout>
