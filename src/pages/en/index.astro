---
import DockNav from "../../components/DockNav.astro";
import Variant5 from "../../components/scratch/Variant5.astro";
import PageBackdrop from "../../components/ui/PageBackdrop.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout
  lang="en"
  title="Benjamin Jesuiter · bjesuiter.de"
  description="Personal landing page of Benjamin Jesuiter with dev, business, and social links."
  bodyClass="bg-[#02110d]"
>
  <DockNav
    locale="en"
    current="home"
    homeHref="/en/"
    resumeHref="/en/cv/"
    supportHref="/en/support/"
    languageSwitchHref="/de/"
  />
  <PageBackdrop
    subtleGrid
    class="px-[clamp(1rem,2.4vw,2.1rem)] py-[clamp(1rem,2.4vw,2.1rem)]"
  >
    <Variant5 locale="en" supportHref="/en/support/" resumeHref="/en/cv/" />
  </PageBackdrop>
</Layout>
