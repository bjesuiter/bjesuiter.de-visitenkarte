---
import DockNav from "../../../components/DockNav.astro";
import CVPrintPretext from "../../../components/CVPrintPretext.astro";
import Layout from "../../../layouts/Layout.astro";
---

<Layout
  lang="en"
  title="Benjamin Jesuiter · CV · Print Preview"
  description="Print preview of the CV of Benjamin Jesuiter using Pretext-guided section placement."
  canonicalPath="/en/cv/"
  noindex={true}
  bodyClass="bg-[#02110d]"
  printPreview={true}
>
  <DockNav
    locale="en"
    current="cv"
    homeHref="/en/"
    cvHref="/en/cv/print/"
    supportHref="/en/support/"
    languageSwitchHref="/de/lebenslauf/drucken/"
  />

  <CVPrintPretext locale="en" />
</Layout>
