---
import DockNav from "../../components/DockNav.astro";
import SupportCard from "../../components/SupportCard.astro";
import PageBackdrop from "../../components/ui/PageBackdrop.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout
  lang="en"
  title="Support · bjesuiter.de"
  description="Support page of Benjamin Jesuiter."
  bodyClass="bg-[#02110d]"
>
  <DockNav
    locale="en"
    current="support"
    homeHref="/en/"
    cvHref="/en/cv/"
    supportHref="/en/support/"
    languageSwitchHref="/de/support/"
  />
  <PageBackdrop
    centered
    class="px-[clamp(1rem,3vw,2rem)] py-[clamp(1rem,3vw,2rem)]"
  >
    <SupportCard locale="en" />
  </PageBackdrop>
</Layout>
