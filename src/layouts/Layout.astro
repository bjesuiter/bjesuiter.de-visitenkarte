---
import { AstroFont } from "astro-font";
import "../css/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonicalPath?: string;
  lang?: "de" | "en";
  bodyClass?: string;
  printPreview?: boolean;
}

const {
  title,
  description = "Persönliche Landingpage von Benjamin Jesuiter mit Links zu Development-, Business- und Social-Profilen.",
  image = "/social-preview-v2.jpg",
  noindex = false,
  canonicalPath,
  lang = "de",
  bodyClass = "",
  printPreview = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://bjesuiter.de");
const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, site);
const socialImageURL = new URL(image, site);
---

<!doctype html>
<html
  lang={lang}
  data-print-preview={printPreview ? "true" : undefined}
  data-cv-print-active={printPreview ? "true" : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      (() => {
        const localizedRouteMap = {
          "/": "/en/",
          "/support": "/en/support/",
        };

        const normalizePathname = (pathname) =>
          pathname.length > 1 && pathname.endsWith("/")
            ? pathname.slice(0, -1)
            : pathname;

        const pathname = normalizePathname(window.location.pathname);
        const englishRoute = localizedRouteMap[pathname];
        if (!englishRoute) return;

        const browserLanguages = navigator.languages ?? [
          navigator.language ?? "",
        ];
        const prefersEnglish = browserLanguages.some((locale) =>
          locale.toLowerCase().startsWith("en"),
        );
        if (!prefersEnglish) return;

        const suffix = `${window.location.search}${window.location.hash}`;
        window.location.replace(`${englishRoute}${suffix}`);
      })();
    </script>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL.href} />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,700&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="bjesuiter.de" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={socialImageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="Benjamin Jesuiter" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL.href} />
    <meta name="twitter:image:alt" content="Benjamin Jesuiter" />
    <title>{title}</title>
  </head>
  <body class:list={["min-w-[300px] font-sans", bodyClass]}>
    <AstroFont
      config={[
        {
          src: [],
          name: "Rubik",
          googleFontsURL:
            "https://fonts.googleapis.com/css2?family=Rubik:ital,wght@0,300..900;1,300..900&display=swap",
          preload: true,
          display: "swap",
          selector: "body",
          fallback: "sans-serif",
        },
        {
          src: [],
          name: "Playwrite",
          googleFontsURL:
            "https://fonts.googleapis.com/css2?family=Playwrite+CU:wght@200&display=swap",
          preload: true,
          display: "swap",
          fallback: "sans-serif",
        },
      ]}
    />
    <slot />
  </body>
</html>

<style is:global>
  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }
</style>
